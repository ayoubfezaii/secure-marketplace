{% extends 'dashboard/_layout.html.twig' %}

{% block title %}Users · Admin · {{ parent() }}{% endblock %}

{% block dash_content %}
    <h1 class="h3 mb-3">Users <span class="text-muted fs-6">({{ pager.total }})</span></h1>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-6"><input type="search" name="q" value="{{ q }}" maxlength="100" class="form-control" placeholder="Search email or name" aria-label="Search"></div>
        <div class="col-md-3">
            <select name="role" class="form-select" aria-label="Role">
                <option value="">All roles</option>
                {% for r, label in {ROLE_BUYER: 'Buyers', ROLE_SELLER: 'Sellers', ROLE_ADMIN: 'Admins'} %}
                    <option value="{{ r }}" {{ role == r ? 'selected' }}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3"><button class="btn btn-outline-primary w-100">Filter</button></div>
    </form>

    <div class="table-responsive bg-white rounded-3 border">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Email</th><th>Name</th><th>Role</th><th>2FA</th><th>Status</th><th>Registered</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            {% for u in pager.items %}
                {% set isAdmin = 'ROLE_ADMIN' in u.roles %}
                {% set isSelf = u.id == app.user.id %}
                <tr>
                    <td>{{ u.email }}{% if isSelf %} <span class="badge text-bg-info">you</span>{% endif %}</td>
                    <td>{{ u.displayName ?? '—' }}</td>
                    <td>{{ isAdmin ? 'Admin' : ('ROLE_SELLER' in u.roles ? 'Seller' : 'Buyer') }}</td>
                    <td>{{ u.totpAuthenticationEnabled ? '✔' : '—' }}</td>
                    <td>
                        {% if u.blocked %}<span class="badge text-bg-danger">Blocked</span>
                        {% elseif u.locked %}<span class="badge text-bg-warning">Locked until {{ u.lockedUntil|date('H:i') }}</span>
                        {% else %}<span class="badge text-bg-success">Active</span>{% endif %}
                    </td>
                    <td class="small">{{ u.createdAt|date('d/m/Y') }}</td>
                    <td class="text-end text-nowrap">
                        {% if isAdmin %}
                            <span class="small text-muted">Managed from the console</span>
                        {% else %}
                            {# SECURITY (rule 3): every action is a POST with a per-user, per-action CSRF token. #}
                            <form method="post" action="{{ path('admin_user_role', {uuid: u.uuid}) }}" class="d-inline-flex gap-1">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin-user-role-' ~ u.uuid) }}">
                                <input type="hidden" name="return_q" value="{{ q }}"><input type="hidden" name="return_role" value="{{ role }}">
                                <select name="role" class="form-select form-select-sm" aria-label="New role">
                                    <option value="buyer" {{ 'ROLE_BUYER' in u.roles ? 'selected' }}>Buyer</option>
                                    <option value="seller" {{ 'ROLE_SELLER' in u.roles ? 'selected' }}>Seller</option>
                                </select>
                                <button class="btn btn-sm btn-outline-secondary">Set</button>
                            </form>
                            {% if u.locked %}
                                <form method="post" action="{{ path('admin_user_unblock', {uuid: u.uuid}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin-user-unblock-' ~ u.uuid) }}">
                                    <input type="hidden" name="return_q" value="{{ q }}"><input type="hidden" name="return_role" value="{{ role }}">
                                    <button class="btn btn-sm btn-outline-success">Unlock</button>
                                </form>
                            {% else %}
                                <form method="post" action="{{ path('admin_user_block', {uuid: u.uuid}) }}" class="d-inline" data-confirm="Block this account? Their sessions will end.">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin-user-block-' ~ u.uuid) }}">
                                    <input type="hidden" name="return_q" value="{{ q }}"><input type="hidden" name="return_role" value="{{ role }}">
                                    <button class="btn btn-sm btn-outline-danger">Block</button>
                                </form>
                            {% endif %}
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">No users found.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% include '_partials/pager.html.twig' with {pager: pager, route: 'admin_users', params: params} %}
{% endblock %}
