{# Audit events. Every value (email, IP, User-Agent, details) is attacker-influenced and auto-escaped (rule 2). #}
{% set danger = ['login.failure', 'login.blocked', 'account.locked', '2fa.failure', 'rate_limited', 'upload.rejected', 'ssrf.blocked', 'password.reset_invalid_token', 'access.denied'] %}
<div class="table-responsive">
    <table class="table table-cards align-middle">
        <thead><tr><th scope="col">Date</th><th scope="col">Action</th><th scope="col">User</th><th scope="col">IP</th>{% if details|default(false) %}<th scope="col">Details</th>{% endif %}</tr></thead>
        <tbody>
            {% for e in events %}
                <tr>
                    <td class="cell-main text-nowrap small">{{ e.createdAt|date('d M Y H:i:s') }}</td>
                    <td data-label="Action"><span class="badge {{ e.action in danger ? 'status-refunded' : 'badge-soft' }} font-monospace">{{ e.action }}</span></td>
                    <td data-label="User" class="small text-break">{{ e.user ? e.user.email : (e.details.email ?? '—') }}</td>
                    <td data-label="IP" class="small font-monospace">{{ e.ip ?? '—' }}</td>
                    {% if details|default(false) %}
                        <td data-label="Details" class="details-cell">{{ e.details|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}{% if e.userAgent %}<br><span class="opacity-75">UA: {{ e.userAgent }}</span>{% endif %}</td>
                    {% endif %}
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-muted small">No events.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
