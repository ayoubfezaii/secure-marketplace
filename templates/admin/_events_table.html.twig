{# Audit events. SECURITY (rule 2): details, IP and User-Agent are attacker-influenced; all auto-escaped. #}
{% if events is empty %}
    <div class="text-center text-muted py-3 bg-white rounded-3 border small">No events.</div>
{% else %}
    <div class="table-responsive bg-white rounded-3 border">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light"><tr><th>Date</th><th>Action</th><th>User</th><th>IP</th><th>Details</th>{% if showUa|default(false) %}<th>User-Agent</th>{% endif %}</tr></thead>
            <tbody>
            {% for e in events %}
                <tr>
                    <td class="text-nowrap small">{{ e.createdAt|date('d/m/Y H:i:s') }}</td>
                    <td><span class="badge {{ e.action in constant('App\\Entity\\AuditLog::SECURITY_EVENTS') ? 'text-bg-danger' : 'text-bg-light border' }}">{{ e.action }}</span></td>
                    <td class="small">{{ e.user ? e.user.email : '—' }}</td>
                    <td class="small text-nowrap">{{ e.ip ?? '—' }}</td>
                    <td class="details-cell">{{ e.details is empty ? '' : e.details|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</td>
                    {% if showUa|default(false) %}<td class="details-cell">{{ e.userAgent }}</td>{% endif %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
