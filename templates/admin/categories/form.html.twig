{% extends 'layouts/dashboard.html.twig' %}

{% set page_title = category ? 'Edit ' ~ category.name : 'New category' %}
{% set crumbs = [['Dashboard', path('admin_dashboard')], ['Categories', path('admin_categories')], [page_title, null]] %}

{% block content %}
    <section class="panel col-xl-7">
        <div class="panel-body">
            {# SECURITY (rules 3, 15): CSRF token; slug format + uniqueness and icon whitelist validated server side. #}
            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                <div class="row g-2">
                    <div class="col-md-6">{{ form_row(form.name) }}</div>
                    <div class="col-md-6">{{ form_row(form.slug) }}</div>
                    <div class="col-12">{{ form_row(form.tagline) }}</div>
                    <div class="col-md-6">{{ form_row(form.icon) }}</div>
                    <div class="col-md-6">{{ form_row(form.position) }}</div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Save</button>
                    <a class="btn btn-light" href="{{ path('admin_categories') }}">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
