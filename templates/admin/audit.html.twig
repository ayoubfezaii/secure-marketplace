{% extends 'dashboard/_layout.html.twig' %}

{% block title %}Audit log · Admin · {{ parent() }}{% endblock %}

{% block dash_content %}
    <h1 class="h3 mb-3">Audit log <span class="text-muted fs-6">({{ pager.total }})</span></h1>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-3">
            <select name="action" class="form-select" aria-label="Action">
                <option value="">All actions</option>
                {% for a in actions %}<option value="{{ a }}" {{ filters.action == a ? 'selected' }}>{{ a }}</option>{% endfor %}
            </select>
        </div>
        <div class="col-md-3"><input type="search" name="user" value="{{ filters.user }}" maxlength="180" class="form-control" placeholder="User email" aria-label="User"></div>
        <div class="col-md-2"><input type="date" name="from" value="{{ filters.from }}" class="form-control" aria-label="From"></div>
        <div class="col-md-2"><input type="date" name="to" value="{{ filters.to }}" class="form-control" aria-label="To"></div>
        <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div>
    </form>

    {% include 'admin/_events_table.html.twig' with {events: pager.items, showUa: true} %}
    {% include '_partials/pager.html.twig' with {pager: pager, route: 'admin_audit', params: params} %}
{% endblock %}
