{% extends 'dashboard/_layout.html.twig' %}

{% block title %}Products · Admin · {{ parent() }}{% endblock %}

{% block dash_content %}
    <h1 class="h3 mb-3">Products moderation <span class="text-muted fs-6">({{ pager.total }})</span></h1>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-6"><input type="search" name="q" value="{{ q }}" maxlength="100" class="form-control" placeholder="Search name or seller email" aria-label="Search"></div>
        <div class="col-md-3">
            <select name="state" class="form-select" aria-label="State">
                <option value="">All</option>
                <option value="active" {{ state == 'active' ? 'selected' }}>Active</option>
                <option value="hidden" {{ state == 'hidden' ? 'selected' }}>Hidden</option>
            </select>
        </div>
        <div class="col-md-3"><button class="btn btn-outline-primary w-100">Filter</button></div>
    </form>

    <div class="table-responsive bg-white rounded-3 border">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th class="col-thumb"></th><th>Name</th><th>Seller</th><th class="text-end">Price</th><th class="text-end">Stock</th><th>Status</th><th class="text-end"></th></tr></thead>
            <tbody>
            {% for p in pager.items %}
                <tr>
                    <td>{% include '_partials/product_image.html.twig' with {product: p, class: 'thumb-sm rounded'} %}</td>
                    <td><a href="{{ path('product_show', {uuid: p.uuid}) }}">{{ p.name }}</a></td>
                    <td class="small">{{ p.seller.email }}</td>
                    <td class="text-end">{{ p.price|format_currency('EUR') }}</td>
                    <td class="text-end">{{ p.stock }}</td>
                    <td>{% if p.active %}<span class="badge text-bg-success">Active</span>{% else %}<span class="badge text-bg-secondary">Hidden</span>{% endif %}</td>
                    <td class="text-end">
                        <form method="post" action="{{ path('admin_product_toggle', {uuid: p.uuid}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin-toggle-' ~ p.uuid) }}">
                            <button class="btn btn-sm {{ p.active ? 'btn-outline-danger' : 'btn-outline-success' }}">{{ p.active ? 'Deactivate' : 'Reactivate' }}</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">No products found.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% include '_partials/pager.html.twig' with {pager: pager, route: 'admin_products', params: params} %}
{% endblock %}
