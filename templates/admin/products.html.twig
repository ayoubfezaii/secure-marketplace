{% extends 'layouts/dashboard.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}
{% import '_ui/table.html.twig' as t %}

{% set page_title = 'Products' %}
{% set page_subtitle = pager.total ~ ' product' ~ (pager.total != 1 ? 's') ~ ' (all sellers)' %}
{% set crumbs = [['Dashboard', path('admin_dashboard')], ['Products', null]] %}

{% block content %}
    <section class="panel">
        <form class="toolbar" method="get" action="{{ path('admin_products') }}" {{ stimulus_controller('autosubmit') }}>
            <div class="search-pill flex-grow-1">
                <label class="visually-hidden" for="q">Search</label><i class="bi bi-search" aria-hidden="true"></i>
                <input class="form-control" id="q" type="search" name="q" maxlength="100" value="{{ list.q }}" placeholder="Product or seller email…">
            </div>
            <label class="visually-hidden" for="seller">Seller</label>
            <select class="form-select" id="seller" name="seller" {{ stimulus_action('autosubmit', 'submit', 'change') }}>
                <option value="">All sellers</option>
                {% for s in sellers %}<option value="{{ s.uuid }}" {{ seller and seller.id == s.id ? 'selected' }}>{{ s.shop ? s.shop.name : s.email }}</option>{% endfor %}
            </select>
            <label class="visually-hidden" for="category">Category</label>
            <select class="form-select" id="category" name="category" {{ stimulus_action('autosubmit', 'submit', 'change') }}>
                <option value="">All categories</option>
                {% for c in categories %}<option value="{{ c.slug }}" {{ category and category.id == c.id ? 'selected' }}>{{ c.name }}</option>{% endfor %}
            </select>
            <label class="visually-hidden" for="state">Status</label>
            <select class="form-select" id="state" name="state" {{ stimulus_action('autosubmit', 'submit', 'change') }}>
                <option value="">Any status</option>
                <option value="active" {{ state == 'active' ? 'selected' }}>Active</option>
                <option value="hidden" {{ state == 'hidden' ? 'selected' }}>Deactivated</option>
            </select>
            <input type="hidden" name="sort" value="{{ list.sort }}"><input type="hidden" name="dir" value="{{ list.dir }}">
            <button class="btn btn-outline-dark" type="submit">Filter</button>
            {% if filters is not empty %}<a class="btn btn-link" href="{{ path('admin_products') }}">Reset</a>{% endif %}
        </form>
        {% if pager.total == 0 %}
            <div class="panel-body">{{ ui.empty_state('No product found', 'Try other filters.', 'Reset', path('admin_products'), 'box-seam') }}</div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover table-cards align-middle">
                    <thead><tr>
                        {{ t.sort_th('Product', 'name', list, 'admin_products', filters) }}
                        <th scope="col">Seller</th><th scope="col">Category</th>
                        {{ t.sort_th('Price', 'price', list, 'admin_products', filters, 'text-end') }}
                        {{ t.sort_th('Stock', 'stock', list, 'admin_products', filters, 'text-end') }}
                        <th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr></thead>
                    <tbody>
                        {% for p in products %}
                            <tr>
                                <td class="cell-main"><div class="cell-product"><span class="thumb">{{ ui.product_image(p.mainImageFilename, p.name) }}</span><a class="name text-truncate" href="{{ path('product_show', {uuid: p.uuid}) }}">{{ p.name }}</a></div></td>
                                <td data-label="Seller" class="small text-break">{{ p.shop ? p.shop.name : p.seller.email }}</td>
                                <td data-label="Category" class="small">{{ p.categoryLabel }}</td>
                                <td data-label="Price" class="text-end">{{ p.price|format_currency('EUR') }}</td>
                                <td data-label="Stock" class="text-end">{{ p.stock }}</td>
                                <td data-label="Status">{{ ui.status_badge(p.active ? 'active' : 'inactive') }}</td>
                                <td class="text-end text-nowrap">
                                    {# SECURITY (rules 3, 4, 14): POST + CSRF + ProductVoter::MODERATE + audit log. #}
                                    {{ ui.confirm_delete_form(path('admin_product_toggle', {uuid: p.uuid}), 'admin-toggle-' ~ p.uuid, p.active ? 'Deactivate' : 'Reactivate', p.active ? 'The product will be hidden from the catalogue.' : 'The product will be visible in the catalogue again.', 'btn btn-sm btn-outline-dark', p.active ? 'eye-slash' : 'eye', {}, null, null, 'dark') }}
                                    {{ ui.confirm_delete_form(path('admin_product_delete', {uuid: p.uuid}), 'admin-delete-' ~ p.uuid, 'Delete', '“' ~ p.name ~ '” will be permanently deleted. Past orders keep their copy.', 'btn btn-sm btn-outline-danger', 'trash3', {}, 'Delete', 'Delete this product?') }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ t.pager(pager, 'admin_products', params) }}
        {% endif %}
    </section>
{% endblock %}
