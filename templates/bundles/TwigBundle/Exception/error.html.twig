{% extends 'base.html.twig' %}

{#
    SECURITY (rule 16): production error page. It shows only a generic message and the status code: never the
    exception message, stack trace, file paths, SQL or framework version. Details go to the server log only.
    (Stack traces appear only in the dev environment, APP_ENV=dev + APP_DEBUG=1.)
    It deliberately uses a minimal shell with NO database query (no categories menu, no cart counter), so it still
    renders when the error comes from the database itself.
#}
{% set titles = {
    400: 'Bad request', 403: 'Access denied', 404: 'Page not found', 405: 'Method not allowed',
    422: 'Invalid request', 429: 'Too many requests', 500: 'Something went wrong', 503: 'Service unavailable'
} %}
{% set messages = {
    403: 'You don\'t have permission to access this page. If you think this is a mistake, log in with the right account.',
    404: 'The page you are looking for doesn\'t exist or has been moved. Let\'s get you back to beautiful things.',
    405: 'This action can\'t be done this way.',
    429: 'You have made too many requests. Please wait a moment and try again.',
    500: 'An unexpected error occurred on our side. The team has been notified. Please try again in a moment.'
} %}
{% set icons = {403: 'shield-lock', 404: 'compass', 429: 'hourglass-split', 500: 'tools'} %}

{% block title %}{{ titles[status_code] ?? 'Error' }} · Maison Secure{% endblock %}

{% block shell %}
    <header class="site-header">
        <div class="container py-3 d-flex align-items-center justify-content-between">
            {% include '_ui/logo.html.twig' %}
            <a class="btn btn-light btn-sm" href="{{ path('product_index') }}">Shop</a>
        </div>
    </header>
    <main id="main" class="container error-page" tabindex="-1">
        <div class="row align-items-center g-4 g-lg-5 w-100 mx-0">
            <div class="col-lg-6 order-lg-2 text-center">
                <div class="error-code" aria-hidden="true">{{ status_code }}</div>
                <div class="empty-illus mx-auto"><i class="bi bi-{{ icons[status_code] ?? 'exclamation-diamond' }}" aria-hidden="true"></i></div>
            </div>
            <div class="col-lg-6">
                <p class="eyebrow mb-2">Error {{ status_code }}</p>
                <h1 class="display-hero mb-3">{{ titles[status_code] ?? 'Error' }}</h1>
                <p class="lead text-muted mb-4">{{ messages[status_code] ?? 'The request could not be completed.' }}</p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="{{ path('app_home') }}" class="btn btn-primary btn-lg">Back to the home page</a>
                    {% if status_code == 403 and not app.user %}
                        <a href="{{ path('app_login') }}" class="btn btn-outline-dark btn-lg">Log in</a>
                    {% elseif app.user %}
                        <a href="{{ path('app_dashboard') }}" class="btn btn-outline-dark btn-lg">My dashboard</a>
                    {% else %}
                        <a href="{{ path('product_index') }}" class="btn btn-outline-dark btn-lg">Browse the shop</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </main>
{% endblock %}
