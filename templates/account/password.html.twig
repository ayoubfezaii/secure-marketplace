{% extends 'dashboard/_layout.html.twig' %}

{% block title %}Change password · {{ parent() }}{% endblock %}

{% block dash_content %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3">Change password</h1>
                    <p class="small text-muted">You will be logged out of all your sessions afterwards.</p>
                    {{ form_start(form) }}
                        {{ form_errors(form) }}
                        {{ form_row(form.currentPassword) }}
                        {{ form_row(form.newPassword.first) }}
                        {{ form_row(form.newPassword.second) }}
                        <button type="submit" class="btn btn-primary w-100">Change password</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
