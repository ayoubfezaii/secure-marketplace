{# FILE: templates/account/password.html.twig #}
{# WHAT: the "Change password" page. #}
{# USED BY: ProfileController::changePassword, route /account/password (any logged-in user). #}
{% extends 'layouts/dashboard.html.twig' %}
{% import '_ui/forms.html.twig' as f %}

{# Variables read by the dashboard layout: title and breadcrumbs. #}
{% set page_title = 'Change password' %}
{% set crumbs = [['Dashboard', path('app_dashboard')], ['Security', path('app_security_settings')], ['Change password', null]] %}

{% block content %}
    <section class="panel col-xl-6">
        <div class="panel-body">
            {# SECURITY (rules 3, 5, 6): CSRF token; current password required; rate limited; all sessions ended after. #}
            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                {# Current password first, then the new password typed twice. #}
                {{ f.password(form.currentPassword) }}
                {{ f.password(form.newPassword.first, true) }}
                {{ f.password(form.newPassword.second) }}
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update password</button>
                    <a class="btn btn-light" href="{{ path('app_security_settings') }}">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
