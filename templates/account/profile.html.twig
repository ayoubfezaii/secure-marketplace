{% extends 'base.html.twig' %}

{% block title %}Profile · {{ parent() }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="h3 mb-3">My profile</h1>

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Email</dt><dd class="col-sm-8">{{ user.email }} <span class="small text-muted">(cannot be changed here)</span></dd>
                        <dt class="col-sm-4">Account type</dt><dd class="col-sm-8">{{ is_granted('ROLE_ADMIN') ? 'Administrator' : (isSeller ? 'Seller' : 'Buyer') }}</dd>
                        <dt class="col-sm-4">Two-factor auth</dt><dd class="col-sm-8">{{ user.totpAuthenticationEnabled ? 'Enabled' : 'Disabled' }} · <a href="{{ path('app_security_settings') }}">Manage</a></dd>
                        <dt class="col-sm-4">Password</dt><dd class="col-sm-8"><a href="{{ path('account_password') }}">Change password</a></dd>
                    </dl>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    {{ form_start(form) }}
                        {{ form_errors(form) }}
                        {{ form_row(form.displayName) }}
                        {{ form_row(form.phone) }}
                        {% if isSeller %}
                            <hr>
                            <h2 class="h6">Payout account</h2>
                            {# SECURITY (rule 11): only the last 4 characters are ever displayed. #}
                            <p class="small">Current IBAN: <strong>{{ user.maskedIban ?? 'none' }}</strong></p>
                            {{ form_row(form.iban) }}
                            {{ form_row(form.removeIban) }}
                        {% endif %}
                        <button type="submit" class="btn btn-primary">Save</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
