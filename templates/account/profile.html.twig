{# FILE: templates/account/profile.html.twig #}
{# WHAT: the "Profile" page: account summary on the left, form (display name, phone) on the right. #}
{# USED BY: ProfileController::profile, route /account/profile (any logged-in user). #}
{% extends 'layouts/dashboard.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{# Variables read by the dashboard layout: title, subtitle and breadcrumbs. #}
{% set page_title = 'Profile' %}
{% set page_subtitle = 'Your public name and contact details.' %}
{% set crumbs = [['Dashboard', path('app_dashboard')], ['Profile', null]] %}

{% block content %}
    <div class="row g-4">
        <div class="col-xl-4">
            <section class="panel text-center">
                <div class="panel-body">
                    {# Left card: read-only summary of the logged-in account. #}
                    <div class="mb-3">{{ ui.avatar(user.publicName, 'xl', 'ink') }}</div>
                    <h2 class="h5 mb-1">{{ user.publicName }}</h2>
                    <p class="small text-muted mb-2 text-break">{{ user.email }}</p>
                    {{ ui.role_badge(user.roles) }}
                    <dl class="kv text-start mt-4 small">
                        <dt>Member since</dt><dd>{{ user.createdAt|date('F Y') }}</dd>
                        <dt>Two-factor</dt><dd>{{ user.totpAuthenticationEnabled ? 'Enabled' : 'Disabled' }}</dd>
                        <dt>Last login</dt><dd>{{ user.lastLoginAt ? user.lastLoginAt|date('d M Y, H:i') : '—' }}</dd>
                    </dl>
                    <a class="btn btn-outline-dark btn-sm w-100" href="{{ path('app_security_settings') }}"><i class="bi bi-shield-lock" aria-hidden="true"></i> Security settings</a>
                </div>
            </section>
        </div>
        <div class="col-xl-8">
            <section class="panel">
                <div class="panel-head"><h2>Personal information</h2></div>
                <div class="panel-body">
                    {# SECURITY (rules 3, 9): CSRF token; bound to ProfileDto (name + phone only). Email and role can't be
                       changed here. #}
                    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                        {{ form_errors(form) }}
                        {# The email is displayed but disabled: it is not a field of the form, so it cannot be changed here (SECURITY: mass assignment). #}
                        <div class="mb-3">
                            <label class="form-label" for="emailRo">Email</label>
                            <input id="emailRo" class="form-control" type="email" value="{{ user.email }}" disabled>
                            <div class="form-text">Your login. Contact support to change it.</div>
                        </div>
                        {# The two editable fields (those of ProfileDto). #}
                        {{ form_row(form.displayName) }}
                        {{ form_row(form.phone) }}
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    {{ form_end(form) }}
                </div>
            </section>
        </div>
    </div>
{% endblock %}
