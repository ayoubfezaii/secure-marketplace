{% extends 'base.html.twig' %}

{% block title %}Register · {{ parent() }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-3">Create an account</h1>

                    {# form_start/form_end render the hidden CSRF field automatically (rule 3). #}
                    {{ form_start(registrationForm) }}
                        {# Form-level errors: invalid CSRF token, unexpected extra fields (e.g. injected "roles"). #}
                        {{ form_errors(registrationForm) }}
                        {{ form_row(registrationForm.email) }}
                        {{ form_row(registrationForm.plainPassword.first) }}
                        {{ form_row(registrationForm.plainPassword.second) }}
                        {{ form_row(registrationForm.accountType) }}
                        <button type="submit" class="btn btn-primary w-100">Register</button>
                    {{ form_end(registrationForm) }}

                    <p class="mt-3 mb-0 text-center small">
                        Already registered? <a href="{{ path('app_login') }}">Log in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
