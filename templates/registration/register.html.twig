{# FILE: templates/registration/register.html.twig #}
{# WHAT: the "Create an account" page. #}
{# USED BY: RegistrationController::register, route /register (visitors). #}
{% extends 'layouts/auth.html.twig' %}
{% import '_ui/forms.html.twig' as f %}

{% block title %}Create an account · Maison Secure{% endblock %}
{% block quote %}“Join a marketplace where every review is real and every account is protected.”{% endblock %}

{% block body %}
    <p class="eyebrow mb-2">Join us</p>
    <h1 class="mb-2">Create your account</h1>
    <p class="text-muted mb-4">Shop pieces made to last from independent makers.</p>

    {# SECURITY (rules 3, 9): CSRF token via form_start/form_end; explicit fields only. Every new account is a
       BUYER: the role is not a form field and is set by the server. #}
    {{ form_start(registrationForm, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(registrationForm) }}
        {# form_row() prints the label, the input and the errors of one field. Only the fields of RegistrationFormType exist. #}
        {{ form_row(registrationForm.displayName) }}
        {{ form_row(registrationForm.email) }}
        {{ f.password(registrationForm.plainPassword.first, true) }}
        {{ f.password(registrationForm.plainPassword.second) }}
        {{ form_row(registrationForm.agreeTerms) }}
        <button type="submit" class="btn btn-primary btn-lg w-100">Create my account</button>
    {# form_end() closes the form and prints the hidden CSRF token. #}
    {{ form_end(registrationForm) }}

    <div class="surface p-3 mt-4 d-flex gap-3 align-items-start">
        <i class="bi bi-shop fs-4" aria-hidden="true"></i>
        <p class="small mb-0"><strong>Want to sell?</strong> Create your account first, then apply as a seller from your dashboard. Our team reviews every shop before it opens.</p>
    </div>
    <p class="mt-4 mb-0 text-center">Already have an account? <a class="fw-semibold" href="{{ path('app_login') }}">Log in</a></p>
{% endblock %}
