<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Secure Marketplace{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🛒</text></svg>">
        {% block stylesheets %}{% endblock %}
        {# Bootstrap is served from this app through AssetMapper, not a CDN, so the future CSP can stay at 'self' (rule 13). #}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="bg-light d-flex flex-column min-vh-100">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">Secure Marketplace</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        {% if app.user %}
                            <li class="nav-item">
                                {# Auto-escaped output (rule 2). #}
                                <span class="navbar-text">{{ app.user.userIdentifier }}</span>
                            </li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_security_settings') }}">Security</a></li>
                            <li class="nav-item">
                                {# SECURITY (rule 3): logout is a POST with a CSRF token, never a GET link. #}
                                <form method="post" action="{{ path('app_logout') }}" class="d-inline">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                                </form>
                            </li>
                        {% else %}
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Log in</a></li>
                            <li class="nav-item"><a class="btn btn-primary btn-sm" href="{{ path('app_register') }}">Register</a></li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <main class="container py-4 flex-grow-1">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }}" role="alert">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="py-3 text-center text-muted small border-top">
            Secure Marketplace: university cybersecurity project
        </footer>
    </body>
</html>
