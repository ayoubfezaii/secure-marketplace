<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light">
        <title>{% block title %}Maison Secure · Shop beautifully. Shop safely.{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Maison Secure: curated pieces made to last, from independent sellers. Secure checkout, free shipping, easy returns.{% endblock %}">
        <link rel="icon" type="image/svg+xml" href="{{ asset('images/favicon.svg') }}">
        {% block stylesheets %}
            {# Served by this app through AssetMapper (versioned URLs), allowed by style-src / font-src 'self'. #}
            <link rel="stylesheet" href="{{ asset('vendor/bootstrap/dist/css/bootstrap.min.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/vendor/bootstrap-icons.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/fonts.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/tokens.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}
        {% block javascripts %}
            {# SECURITY (rule 13): the importmap's inline <script> tags carry a random per-response CSP nonce; any other
               inline script (e.g. injected by XSS) has no nonce and is blocked by the browser. All CSS, fonts and icons
               are served by this app (AssetMapper): no CDN, so the CSP stays at 'self'. #}
            {% block importmap %}{{ importmap('app', {nonce: csp_nonce('script')}) }}{% endblock %}
        {% endblock %}
    </head>
    {# Turbo Drive disabled: plain page loads keep the CSP nonce model simple and predictable.
       The "confirm" controller turns <form data-confirm="..."> into an accessible confirmation modal. #}
    <body class="{% block body_class %}{% endblock %}" data-turbo="false" {{ stimulus_controller('confirm') }}>
        <a class="skip-link" href="#main">Skip to content</a>

        {% block shell %}
            {% include 'layouts/_store_header.html.twig' %}
            <main id="main" class="{% block main_class %}container py-4{% endblock %}" tabindex="-1">
                {% block body %}{% endblock %}
            </main>
            {% include 'layouts/_store_footer.html.twig' %}
        {% endblock %}

        {% include 'layouts/_toasts.html.twig' %}
        {% include 'layouts/_confirm_modal.html.twig' %}
    </body>
</html>
