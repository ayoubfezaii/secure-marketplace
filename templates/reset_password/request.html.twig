{% extends 'base.html.twig' %}

{% block title %}Forgot password · {{ parent() }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-3">Reset your password</h1>
                    <p class="text-muted small">Enter your email address. If an account exists, we will send you a link to choose a new password.</p>

                    {{ form_start(requestForm) }}
                        {{ form_errors(requestForm) }}
                        {{ form_row(requestForm.email) }}
                        <button class="btn btn-primary w-100" type="submit">Send reset link</button>
                    {{ form_end(requestForm) }}

                    <p class="mt-3 mb-0 text-center small"><a href="{{ path('app_login') }}">Back to log in</a></p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
