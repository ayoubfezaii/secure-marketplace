{% extends 'layouts/auth.html.twig' %}

{% block title %}Forgot password · Maison Secure{% endblock %}
{% block quote %}“Locked out? It happens. We'll get you back in, safely.”{% endblock %}

{% block body %}
    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-sand mb-3 icon-badge"><i class="bi bi-key fs-4" aria-hidden="true"></i></span>
    <h1 class="mb-2">Forgot your password?</h1>
    <p class="text-muted mb-4">Enter the email address of your account. If it exists, we will send you a link to choose a new password.</p>
    {# SECURITY (rules 3, 6): CSRF token + per-IP rate limit; the next page is identical whether or not the email
       exists (no user enumeration). #}
    {{ form_start(requestForm, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(requestForm) }}
        {{ form_row(requestForm.email, {attr: {placeholder: 'you@example.com', autofocus: 'autofocus'}}) }}
        <button class="btn btn-primary btn-lg w-100" type="submit">Send reset link</button>
    {{ form_end(requestForm) }}
    <p class="mt-4 mb-0 text-center"><a href="{{ path('app_login') }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to log in</a></p>
{% endblock %}
