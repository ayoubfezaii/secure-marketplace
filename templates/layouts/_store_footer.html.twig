{# Storefront footer: 4 columns, newsletter, social and payment icons (generic SVG shapes, no third-party logos). #}
{% set categories = store_categories() %}
<footer class="site-footer mt-5">
    <div class="container pt-5 pb-4">
        <div class="row g-4 g-lg-5">
            <div class="col-lg-4">
                {% include '_ui/logo.html.twig' with {invert: true} %}
                <p class="mt-3 small">Independent makers and carefully chosen pieces, built to last. Every account is protected by modern security: hashed passwords, optional two-factor authentication and encrypted payout data.</p>
                <form class="mt-3" method="post" action="{{ path('newsletter_subscribe') }}">
                    {# SECURITY (rule 3): CSRF token; the endpoint is also rate limited per IP (rule 6). #}
                    <input type="hidden" name="_token" value="{{ csrf_token('newsletter') }}">
                    <input type="hidden" name="_back" value="{{ app.request.pathInfo }}">
                    <label class="form-label small text-white" for="footerNewsletter">Get new arrivals &amp; private sales</label>
                    <div class="d-flex gap-2">
                        <input id="footerNewsletter" class="form-control input-pill" type="email" name="email" required maxlength="180" placeholder="you@example.com" autocomplete="email">
                        <button class="btn btn-cream" type="submit">Join</button>
                    </div>
                </form>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <h2>Shop</h2>
                <ul class="list-unstyled d-grid gap-2 small">
                    <li><a href="{{ path('product_index') }}">All products</a></li>
                    <li><a href="{{ path('product_index', {sort: 'newest'}) }}">New arrivals</a></li>
                    <li><a href="{{ path('product_index', {deals: 1}) }}">Deals</a></li>
                    {% for c in categories|slice(0, 3) %}<li><a href="{{ path('product_index', {category: c.slug}) }}">{{ c.name }}</a></li>{% endfor %}
                </ul>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <h2>Customer care</h2>
                <ul class="list-unstyled d-grid gap-2 small">
                    <li><a href="{{ path('app_about') }}#shipping">Shipping &amp; returns</a></li>
                    <li><a href="{{ path('app_home') }}#faq">FAQ</a></li>
                    <li><a href="{{ path('app_about') }}#security">Security &amp; privacy</a></li>
                    <li><a href="{{ path('app_about') }}#contact">Contact us</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <h2>Account</h2>
                <ul class="list-unstyled d-grid gap-2 small">
                    {% if app.user %}
                        <li><a href="{{ path('app_dashboard') }}">My dashboard</a></li>
                        {% if can_shop() %}
                            <li><a href="{{ path('buyer_orders') }}">My orders</a></li>
                            <li><a href="{{ path('buyer_wishlist') }}">Wishlist</a></li>
                        {% endif %}
                        <li><a href="{{ path('app_security_settings') }}">Security settings</a></li>
                    {% else %}
                        <li><a href="{{ path('app_login') }}">Log in</a></li>
                        <li><a href="{{ path('app_register') }}">Create an account</a></li>
                        <li><a href="{{ path('app_register') }}">Sell with us</a></li>
                    {% endif %}
                </ul>
            </div>
            <div class="col-6 col-md-3 col-lg-2" id="footer-contact">
                <h2>Contact</h2>
                <ul class="list-unstyled d-grid gap-2 small">
                    <li><i class="bi bi-envelope me-1" aria-hidden="true"></i> care@maison-secure.test</li>
                    <li><i class="bi bi-telephone me-1" aria-hidden="true"></i> +33 1 00 00 00 00</li>
                    <li><i class="bi bi-clock me-1" aria-hidden="true"></i> Mon–Sat, 9am–7pm</li>
                </ul>
                <div class="social d-flex gap-2 mt-3">
                    <a href="{{ path('app_about') }}#journal" aria-label="Our journal"><i class="bi bi-journal-richtext" aria-hidden="true"></i></a>
                    <a href="{{ path('app_about') }}#gallery" aria-label="Photo gallery"><i class="bi bi-camera" aria-hidden="true"></i></a>
                    <a href="{{ path('app_about') }}#videos" aria-label="Videos"><i class="bi bi-play-circle" aria-hidden="true"></i></a>
                    <a href="{{ path('app_about') }}#contact" aria-label="Write to us"><i class="bi bi-chat-heart" aria-hidden="true"></i></a>
                </div>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="container py-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <p class="mb-0">&copy; {{ 'now'|date('Y') }} Maison Secure · University cybersecurity project. Payments are simulated.</p>
            <div class="pay-icons d-flex gap-2" aria-label="Accepted payment methods: cards, bank transfer, digital wallet">
                {# Generic payment shapes drawn locally (no third-party brand logos). #}
                <svg viewBox="0 0 46 30" aria-hidden="true"><rect x=".5" y=".5" width="45" height="29" rx="5" fill="#222" stroke="#3a3a3a"/><rect x="6" y="9" width="9" height="7" rx="1.5" fill="#D4A017"/><rect x="6" y="20" width="22" height="2.5" rx="1" fill="#8B7E74"/></svg>
                <svg viewBox="0 0 46 30" aria-hidden="true"><rect x=".5" y=".5" width="45" height="29" rx="5" fill="#222" stroke="#3a3a3a"/><circle cx="19" cy="15" r="7" fill="#E8701A"/><circle cx="27" cy="15" r="7" fill="#F7F3EE" fill-opacity=".8"/></svg>
                <svg viewBox="0 0 46 30" aria-hidden="true"><rect x=".5" y=".5" width="45" height="29" rx="5" fill="#222" stroke="#3a3a3a"/><path d="M12 12 23 6l11 6Z" fill="#F7F3EE"/><rect x="14" y="13" width="3" height="8" fill="#F7F3EE"/><rect x="21.5" y="13" width="3" height="8" fill="#F7F3EE"/><rect x="29" y="13" width="3" height="8" fill="#F7F3EE"/><rect x="11" y="22" width="24" height="2.5" fill="#F7F3EE"/></svg>
                <svg viewBox="0 0 46 30" aria-hidden="true"><rect x=".5" y=".5" width="45" height="29" rx="5" fill="#222" stroke="#3a3a3a"/><rect x="14" y="8" width="18" height="14" rx="3" fill="none" stroke="#F7F3EE" stroke-width="2"/><circle cx="28" cy="15" r="1.8" fill="#E8701A"/></svg>
                <svg viewBox="0 0 46 30" aria-hidden="true"><rect x=".5" y=".5" width="45" height="29" rx="5" fill="#222" stroke="#3a3a3a"/><rect x="17" y="13" width="12" height="10" rx="2" fill="#2E7D5B"/><path d="M19.5 13v-2.5a3.5 3.5 0 0 1 7 0V13" fill="none" stroke="#2E7D5B" stroke-width="2"/></svg>
            </div>
        </div>
    </div>
</footer>
