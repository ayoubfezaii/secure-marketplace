{# Shared confirmation modal (see assets/controllers/confirm_controller.js). The texts are set with textContent. #}
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalTitle" aria-hidden="true" {{ stimulus_target('confirm', 'modal') }}>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-2">
            <div class="modal-body text-center pt-4">
                <span class="modal-icon mb-3"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
                <h2 class="h4" id="confirmModalTitle" {{ stimulus_target('confirm', 'title') }}>Please confirm</h2>
                <p class="text-muted mb-0" {{ stimulus_target('confirm', 'message') }}></p>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" {{ stimulus_target('confirm', 'confirmButton') }} {{ stimulus_action('confirm', 'accept') }}>Confirm</button>
            </div>
        </div>
    </div>
</div>
