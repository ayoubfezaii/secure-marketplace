{# FILE: templates/layouts/_sidebar.html.twig #}
{# WHAT: the left menu of the dashboards (logo, role badge, links, logout). #}
{# USED BY: layouts/dashboard.html.twig, for buyers, sellers and admins (each role gets its own links). #}
{# Dashboard sidebar. The menu comes from DashboardNavigation (role decided server side). Links only: every target
   route enforces its own access rules (access_control + #[IsGranted] + Voters). #}
{% set role = dashboard_role() %}
{% include '_ui/logo.html.twig' with {invert: true} %}
<div class="px-4 pb-2">
    {# Badge showing the role of the logged-in user. #}
    {% if role == 'ROLE_ADMIN' %}<span class="badge role-badge role-admin border border-secondary">Admin</span>
    {% elseif role == 'ROLE_SELLER' %}<span class="badge role-badge role-seller">Seller</span>
    {% else %}<span class="badge role-badge role-buyer">Buyer</span>{% endif %}
</div>
<nav aria-label="Dashboard">
    {# Loop over the menu sections, then over the links of each section. Labels are escaped by Twig. #}
    {% for section, items in dashboard_menu() %}
        <div class="side-label">{{ section }}</div>
        {% for item in items %}
            <a href="{{ path(item.route) }}" class="side-link {{ item.active ? 'active' }}" {% if item.active %}aria-current="page"{% endif %} title="{{ item.label }}">
                <i class="bi bi-{{ item.icon }}" aria-hidden="true"></i><span class="label">{{ item.label }}</span>
            </a>
        {% endfor %}
    {% endfor %}
</nav>
<div class="side-footer">
    <a href="{{ path('app_home') }}" class="side-link m-0 mb-1"><i class="bi bi-shop" aria-hidden="true"></i><span class="label">Back to the store</span></a>
    {# SECURITY (rule 3): logout is a POST with a CSRF token. #}
    <form method="post" action="{{ path('app_logout') }}">
        {# Hidden CSRF token: the server refuses the logout without it, so another site cannot log the user out. #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button type="submit" class="side-link m-0 w-100 border-0 bg-transparent"><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span class="label">Log out</span></button>
    </form>
</div>
