{% extends 'base.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{#
    App-style layout shared by /buyer, /seller, /admin and /account.
    Child templates set:   {% set page_title = '...' %}  {% set page_subtitle = '...' %}  {% set crumbs = [[label, url|null], ...] %}
    and fill the blocks:   page_actions (optional), content.
#}
{% block title %}{{ page_title|default('Dashboard') }} · Maison Secure{% endblock %}
{% block body_class %}dashboard-page{% endblock %}

{% block shell %}
    {% set me = app.user %}
    <div class="app-shell" {{ stimulus_controller('sidebar') }}>
        <aside class="app-sidebar" aria-label="Sidebar">
            {% include 'layouts/_sidebar.html.twig' %}
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <button class="btn btn-icon btn-light d-none d-lg-inline-flex" type="button" {{ stimulus_action('sidebar', 'toggle') }} aria-label="Collapse or expand the sidebar">
                    <i class="bi bi-layout-sidebar" aria-hidden="true"></i>
                </button>
                <button class="btn btn-icon btn-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#dashMenu" aria-controls="dashMenu" aria-label="Open the menu">
                    <i class="bi bi-list fs-5" aria-hidden="true"></i>
                </button>

                {% set search_route = dashboard_search_route() %}
                {% if search_route %}
                    {# GET search; the term is length-capped, bound as a parameter and auto-escaped (rules 1, 2, 15). #}
                    <form class="search-pill flex-grow-1 d-none d-md-block header-search" action="{{ path(search_route) }}" method="get" role="search">
                        <label class="visually-hidden" for="dashSearch">Search</label>
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input id="dashSearch" class="form-control" type="search" name="q" maxlength="100" placeholder="{{ dashboard_search_placeholder() }}" value="{{ app.request.attributes.get('_route') == search_route ? app.request.query.get('q', '')|slice(0, 100) }}">
                    </form>
                {% endif %}

                <div class="ms-auto d-flex align-items-center gap-2">
                    <a class="btn btn-light btn-sm d-none d-sm-inline-flex align-items-center gap-1" href="{{ path('app_home') }}"><i class="bi bi-shop" aria-hidden="true"></i> Store</a>

                    {% set notifications = dashboard_notifications() %}
                    <div class="dropdown">
                        <button class="btn btn-icon btn-light position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications ({{ notifications|length }})">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                            {% if notifications is not empty %}<span class="notif-dot" aria-hidden="true"></span>{% endif %}
                        </button>
                        <div class="dropdown-menu dropdown-menu-end notif-menu">
                            <h2 class="h6 px-2 pt-1 pb-2 mb-1 border-bottom">Notifications</h2>
                            {% for n in notifications %}
                                <a class="dropdown-item d-flex gap-2 align-items-start" href="{{ path(n.route, n.params) }}">
                                    <i class="bi bi-{{ n.icon }} {{ n.tone == 'danger' ? 'text-danger' : (n.tone == 'accent' ? 'text-accent') }}" aria-hidden="true"></i>
                                    <span class="small text-wrap">{{ n.text }}</span>
                                </a>
                            {% else %}
                                <p class="small text-muted px-2 py-2 mb-0"><i class="bi bi-check2-circle" aria-hidden="true"></i> You're all caught up.</p>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-light d-flex align-items-center gap-2 py-1 ps-1 pe-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User menu">
                            {{ ui.avatar(me.publicName, 'sm', 'ink') }}
                            <span class="d-none d-md-inline small fw-semibold text-truncate user-name">{{ me.publicName }}</span>
                            <i class="bi bi-chevron-down small" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li class="px-3 py-2 small text-muted">{{ ui.role_badge(me.roles) }}<br><span class="text-truncate d-inline-block user-email">{{ me.email }}</span></li>
                            <li><a class="dropdown-item" href="{{ path('account_profile') }}"><i class="bi bi-person-circle me-2" aria-hidden="true"></i>Profile</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_security_settings') }}"><i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Security</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_home') }}"><i class="bi bi-shop me-2" aria-hidden="true"></i>Back to the store</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                {# SECURITY (rule 3): logout is a POST with a CSRF token. #}
                                <form method="post" action="{{ path('app_logout') }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Log out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main id="main" class="app-content" tabindex="-1">
                <header class="page-header pt-0 d-flex flex-wrap align-items-end justify-content-between gap-3">
                    <div class="min-w-0">
                        {{ ui.breadcrumbs(crumbs|default([['Dashboard', path('app_dashboard')], [page_title|default('Overview'), null]])) }}
                        <h1>{{ page_title|default('Dashboard') }}</h1>
                        {% if page_subtitle|default(null) %}<p class="text-muted mb-0 mt-1">{{ page_subtitle }}</p>{% endif %}
                    </div>
                    <div class="d-flex flex-wrap gap-2">{% block page_actions %}{% endblock %}</div>
                </header>
                {% block content %}{% endblock %}
            </main>
        </div>
    </div>

    {# Mobile sidebar #}
    <div class="offcanvas offcanvas-start app-offcanvas" tabindex="-1" id="dashMenu" aria-label="Dashboard menu">
        <div class="offcanvas-header pb-0">
            <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
        </div>
        <div class="offcanvas-body p-0">
            <div class="app-sidebar">{% include 'layouts/_sidebar.html.twig' %}</div>
        </div>
    </div>
{% endblock %}
