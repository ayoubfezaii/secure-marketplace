{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} · {{ parent() }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="{{ path('product_index') }}">Products</a></li>
            <li class="breadcrumb-item"><a href="{{ path('product_index', {category: product.category}) }}">{{ product.categoryLabel }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ product.name }}</li>
        </ol>
    </nav>

    {% if not product.active %}
        <div class="alert alert-warning">This product is hidden from the catalogue. Only you{{ is_granted('ROLE_ADMIN') ? ' and other admins' }} can see it.</div>
    {% endif %}

    <div class="row g-4">
        <div class="col-md-6">
            {% include '_partials/product_image.html.twig' with {product: product, class: 'product-main-img rounded border'} %}
        </div>
        <div class="col-md-6">
            <span class="badge text-bg-light border">{{ product.categoryLabel }}</span>
            {# SECURITY (rule 2): auto-escaped; a name like <script> is shown as text. #}
            <h1 class="h3 mt-2">{{ product.name }}</h1>
            {# Seller's public name, never the email address. #}
            <p class="text-muted mb-2">Sold by <strong>{{ product.seller.publicName }}</strong></p>
            <p class="mb-2">
                {% if rating.count > 0 %}
                    {% include "_partials/stars.html.twig" with {value: rating.avg} %}
                    <a href="#reviews" class="small">{{ rating.avg }} / 5 ({{ rating.count }} review{{ rating.count > 1 ? "s" }})</a>
                {% else %}
                    <span class="small text-muted">No reviews yet</span>
                {% endif %}
            </p>
            <p class="fs-3 fw-semibold">{{ product.price|format_currency('EUR') }}</p>
            <p>
                {% if product.stock > 0 %}
                    <span class="badge text-bg-success">In stock</span> <span class="small text-muted">{{ product.stock }} available</span>
                {% else %}
                    <span class="badge text-bg-secondary">Out of stock</span>
                {% endif %}
            </p>
            {% if is_granted("ROLE_BUYER") and product.purchasable %}
                {# SECURITY (rules 3, 10): POST + CSRF; only a product id and a quantity are sent, never a price. #}
                <form method="post" action="{{ path("cart_add", {uuid: product.uuid}) }}" class="d-flex gap-2 align-items-center mb-3">
                    <input type="hidden" name="_token" value="{{ csrf_token("cart-add-" ~ product.uuid) }}">
                    <label for="quantity" class="visually-hidden">Quantity</label>
                    <input type="number" id="quantity" name="quantity" value="1" min="1" max="{{ min(99, product.stock) }}" class="form-control qty-input">
                    <button type="submit" class="btn btn-primary">Add to cart</button>
                </form>
            {% elseif not app.user and product.purchasable %}
                <p><a href="{{ path("app_login", {_target_path: path("product_show", {uuid: product.uuid})}) }}" class="btn btn-outline-primary">Log in as a buyer to purchase</a></p>
            {% endif %}
            <hr>
            <h2 class="h6">Description</h2>
            {# SECURITY (rule 2): plain text with line breaks kept by CSS (white-space: pre-line), no |raw, no nl2br. #}
            <p class="product-description">{{ product.description }}</p>
        </div>
    </div>

    <section id="reviews" class="mt-5">
        <h2 class="h4 mb-3">Reviews</h2>

        {% if reviewForm %}
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h3 class="h6">Write a review</h3>
                    {# SECURITY (rule 3): CSRF token added by form_start/form_end. #}
                    {{ form_start(reviewForm) }}
                        <div class="row">
                            <div class="col-md-3">{{ form_row(reviewForm.rating) }}</div>
                            <div class="col-md-9">{{ form_row(reviewForm.comment) }}</div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">Publish review</button>
                    {{ form_end(reviewForm) }}
                </div>
            </div>
        {% elseif is_granted("ROLE_BUYER") %}
            <p class="small text-muted">Only buyers who purchased this product can review it, once.</p>
        {% endif %}

        {% for review in reviews %}
            <article class="border-bottom py-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        {% include "_partials/stars.html.twig" with {value: review.rating} %}
                        <strong class="ms-2">{{ review.author.publicName }}</strong>
                        <span class="small text-muted ms-2">{{ review.createdAt|date("d/m/Y") }}</span>
                    </div>
                    {% if is_granted("REVIEW_DELETE", review) %}
                        <form method="post" action="{{ path("review_delete", {uuid: review.uuid}) }}" data-confirm="Delete this review?">
                            <input type="hidden" name="_token" value="{{ csrf_token("delete-review-" ~ review.uuid) }}">
                            <button class="btn btn-sm btn-link text-danger p-0">Delete</button>
                        </form>
                    {% endif %}
                </div>
                {# SECURITY (rule 2): stored XSS impossible. The comment is plain text, auto-escaped, never |raw. #}
                <p class="review-comment mb-0 mt-2">{{ review.comment }}</p>
            </article>
        {% else %}
            <p class="text-muted">No reviews yet.</p>
        {% endfor %}
    </section>
{% endblock %}
