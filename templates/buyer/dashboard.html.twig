{% extends 'layouts/dashboard.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% set page_title = 'Welcome back, ' ~ (app.user.displayName ?? 'there') %}
{% set page_subtitle = 'Here is what is happening with your orders.' %}
{% set crumbs = [['Dashboard', null]] %}

{% block page_actions %}
    <a class="btn btn-primary" href="{{ path('product_index') }}"><i class="bi bi-bag" aria-hidden="true"></i> Continue shopping</a>
{% endblock %}

{% block content %}
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">{{ ui.stat_card('Orders', stats.orders, 'box-seam', 'ink') }}</div>
        <div class="col-6 col-xl-3">{{ ui.stat_card('Total spent', stats.spent|price, 'wallet2', 'accent') }}</div>
        <div class="col-6 col-xl-3"><a class="text-decoration-none" href="{{ path('buyer_wishlist') }}">{{ ui.stat_card('Wishlist', stats.wishlist, 'heart', 'danger') }}</a></div>
        <div class="col-6 col-xl-3"><a class="text-decoration-none" href="{{ path('buyer_reviews') }}">{{ ui.stat_card('Reviews written', stats.reviews, 'star', 'success') }}</a></div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <section class="panel h-100">
                <div class="panel-head"><h2>Recent orders</h2><a class="small" href="{{ path('buyer_orders') }}">All orders <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
                {% if recentOrders is empty %}
                    <div class="panel-body">{{ ui.empty_state('No orders yet', 'Your orders will appear here once you check out.', 'Start shopping', path('product_index'), 'box-seam') }}</div>
                {% else %}
                    {% include 'buyer/_orders_table.html.twig' with {orders: recentOrders} %}
                {% endif %}
            </section>
        </div>
        <div class="col-xl-4">
            <section class="panel h-100">
                <div class="panel-head"><h2>Products to review</h2></div>
                <div class="panel-body">
                    {% for product in toReview %}
                        <div class="d-flex align-items-center gap-3 {{ not loop.last ? 'mb-3' }}">
                            <span class="thumb">{{ ui.product_image(product.mainImageFilename, product.name) }}</span>
                            <div class="min-w-0 flex-grow-1">
                                <p class="small fw-semibold text-truncate mb-1">{{ product.name }}</p>
                                <a class="btn btn-sm btn-outline-dark" href="{{ path('product_show', {uuid: product.uuid}) }}#reviews-tab-pane"><i class="bi bi-pencil" aria-hidden="true"></i> Write a review</a>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-muted small mb-0"><i class="bi bi-check2-circle" aria-hidden="true"></i> You have reviewed everything you bought. Thank you!</p>
                    {% endfor %}
                </div>
            </section>
        </div>
    </div>

    {% if recommended is not empty %}
        <section class="mt-4">
            <div class="d-flex justify-content-between align-items-end mb-3"><h2 class="h4 mb-0">Recommended for you</h2><a class="small" href="{{ path('product_index') }}">Shop all</a></div>
            <div class="row row-cols-2 row-cols-lg-4 g-3">
                {% for product in recommended %}<div class="col">{{ ui.product_card(product) }}</div>{% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
