{% extends 'layouts/dashboard.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% set page_title = 'Edit your review' %}
{% set crumbs = [['Dashboard', path('buyer_dashboard')], ['My reviews', path('buyer_reviews')], ['Edit', null]] %}

{% block content %}
    <section class="panel col-xl-8">
        <div class="panel-head">
            <div class="d-flex gap-3 align-items-center">
                <span class="thumb">{{ ui.product_image(review.product.mainImageFilename, review.product.name) }}</span>
                <h2>{{ review.product.name }}</h2>
            </div>
        </div>
        <div class="panel-body">
            {# SECURITY (rules 3, 9): CSRF token; only rating + comment can change. #}
            {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_row(form.rating) }}
                {{ form_row(form.comment) }}
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a class="btn btn-light" href="{{ path('buyer_reviews') }}">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
