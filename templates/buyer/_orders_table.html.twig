{# FILE: templates/buyer/_orders_table.html.twig #}
{# WHAT: a table of orders (number, date, items, status, payment, total). #}
{# USED BY: buyer/dashboard.html.twig and buyer/orders.html.twig (buyer: own orders only). #}
{% import '_ui/macros.html.twig' as ui %}
<div class="table-responsive">
    <table class="table table-hover table-cards align-middle">
        <thead>
            <tr><th scope="col">Order</th><th scope="col">Date</th><th scope="col">Items</th><th scope="col">Status</th><th scope="col">Payment</th><th scope="col" class="text-end">Total</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
        </thead>
        <tbody>
            {# Loop: one row per order. Links use the order UUID, not a numeric id (SECURITY: IDOR). #}
            {% for order in orders %}
                <tr>
                    <td class="cell-main"><a class="fw-semibold font-monospace" href="{{ path('order_show', {uuid: order.uuid}) }}">{{ order.number }}</a></td>
                    <td data-label="Date">{{ order.createdAt|date('d M Y') }}</td>
                    <td data-label="Items">{{ order.items|length }}</td>
                    <td data-label="Status">{{ ui.status_badge(order.status) }}</td>
                    <td data-label="Payment"><span class="small d-block">{{ ui.payment_method(order) }}</span>{{ ui.payment_status_badge(order) }}</td>
                    <td data-label="Total" class="text-end fw-semibold">{{ order.total|price }}</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-dark" href="{{ path('order_show', {uuid: order.uuid}) }}">View</a></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
