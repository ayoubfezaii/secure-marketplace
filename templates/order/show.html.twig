{% extends 'base.html.twig' %}

{% block title %}Order · {{ parent() }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-1">Order {{ order.uuid|slice(0, 8)|upper }}</h1>
            <span class="text-muted small">Placed on {{ order.createdAt|date('d/m/Y H:i') }}</span>
        </div>
        {% include '_partials/status_badge.html.twig' with {status: order.status} %}
    </div>

    {% if not isBuyer and not isAdmin %}
        <div class="alert alert-info small">You only see the items you sold in this order.</div>
    {% endif %}

    <div class="table-responsive bg-white rounded-3 border mb-3">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>Product</th>{% if isBuyer or isAdmin %}<th>Seller</th>{% endif %}<th class="text-end">Unit price</th><th class="text-end">Qty</th><th class="text-end">Total</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
            {% for item in items %}
                <tr>
                    <td>
                        {% if item.product and item.product.active %}
                            <a href="{{ path('product_show', {uuid: item.product.uuid}) }}">{{ item.productName }}</a>
                        {% else %}
                            {{ item.productName }}
                        {% endif %}
                    </td>
                    {% if isBuyer or isAdmin %}<td>{{ item.seller.publicName }}</td>{% endif %}
                    <td class="text-end">{{ item.unitPrice|format_currency('EUR') }}</td>
                    <td class="text-end">{{ item.quantity }}</td>
                    <td class="text-end">{{ item.lineTotal|format_currency('EUR') }}</td>
                    <td>{% include '_partials/status_badge.html.twig' with {status: item.status} %}</td>
                    <td class="text-end">
                        {% if is_granted('ORDER_ITEM_UPDATE_STATUS', item) %}
                            {% include '_partials/item_status_action.html.twig' with {item: item, back: 'order'} %}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
            {% if isBuyer or isAdmin %}
                <tfoot><tr><th colspan="4" class="text-end">Total paid</th><th class="text-end">{{ order.total|format_currency('EUR') }}</th><th colspan="2"></th></tr></tfoot>
            {% endif %}
        </table>
    </div>

    {% if isBuyer or isAdmin %}
        <p class="small text-muted">Paid by card •••• {{ order.cardLast4 }} ({{ order.cardHolder }})</p>
    {% endif %}
{% endblock %}
