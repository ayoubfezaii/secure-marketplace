{% extends 'dashboard/_layout.html.twig' %}

{% block title %}Orders to fulfil · {{ parent() }}{% endblock %}

{% block dash_content %}
    <h1 class="h3 mb-3">Orders containing my products</h1>
    {% if orders is empty %}
        <div class="text-center text-muted py-5 bg-white rounded-3 border">No orders yet.</div>
    {% else %}
        {% include 'order/_seller_table.html.twig' with {back: 'orders'} %}
    {% endif %}
{% endblock %}
