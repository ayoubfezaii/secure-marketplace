{% extends 'base.html.twig' %}

{% block title %}My orders · {{ parent() }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">My orders</h1>
    {% if orders is empty %}
        <div class="text-center text-muted py-5 bg-white rounded-3 border">
            <p class="mb-2">You haven't placed any order yet.</p>
            <a href="{{ path('product_index') }}" class="btn btn-outline-primary btn-sm">Browse products</a>
        </div>
    {% else %}
        {% include 'order/_buyer_table.html.twig' %}
    {% endif %}
{% endblock %}
