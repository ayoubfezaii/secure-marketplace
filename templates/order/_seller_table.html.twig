{# Seller view: only THIS seller's items of each order (Order::getItemsForSeller), never the buyer's email/payment. #}
{% import '_ui/macros.html.twig' as ui %}
<div class="table-responsive">
    <table class="table table-hover table-cards align-middle">
        <thead><tr><th scope="col">Order</th><th scope="col">Date</th><th scope="col">Ship to</th><th scope="col">Product</th><th scope="col" class="text-end">Qty</th><th scope="col" class="text-end">Amount</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
        {% for order in orders %}
            {% for item in order.itemsForSeller(app.user) %}
                <tr>
                    <td class="cell-main"><a class="fw-semibold font-monospace" href="{{ path('seller_order_show', {uuid: order.uuid}) }}">{{ order.number }}</a>{% if order.cashOnDelivery %}<br><span class="small text-muted text-nowrap"><i class="bi bi-cash-coin" aria-hidden="true"></i> Cash · {{ order.paymentStatus.label|lower }}</span>{% endif %}</td>
                    <td data-label="Date">{{ order.createdAt|date('d M Y') }}</td>
                    <td data-label="Ship to">{{ order.shippingName ?? '—' }}</td>
                    <td data-label="Product" class="text-truncate">{{ item.productName }}</td>
                    <td data-label="Qty" class="text-end">{{ item.quantity }}</td>
                    <td data-label="Amount" class="text-end">{{ item.lineTotal|price }}</td>
                    <td data-label="Status">{{ ui.status_badge(item.status) }}</td>
                    <td class="text-end text-nowrap">{% include '_partials/item_status_action.html.twig' with {item: item, back: back|default('orders')} %}</td>
                </tr>
            {% endfor %}
        {% endfor %}
        </tbody>
    </table>
</div>
