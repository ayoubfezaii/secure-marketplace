{# Seller view: only THIS seller's items of each order (Order::getItemsForSeller). #}
<div class="table-responsive bg-white rounded-3 border">
    <table class="table align-middle mb-0">
        <thead class="table-light"><tr><th>Order</th><th>Date</th><th>Product</th><th class="text-end">Qty</th><th class="text-end">Amount</th><th>Status</th><th></th></tr></thead>
        <tbody>
        {% for order in orders %}
            {% for item in order.itemsForSeller(app.user) %}
                <tr>
                    <td><a href="{{ path('order_show', {uuid: order.uuid}) }}">{{ order.uuid|slice(0, 8)|upper }}</a></td>
                    <td>{{ order.createdAt|date('d/m/Y') }}</td>
                    <td>{{ item.productName }}</td>
                    <td class="text-end">{{ item.quantity }}</td>
                    <td class="text-end">{{ item.lineTotal|format_currency('EUR') }}</td>
                    <td>{% include '_partials/status_badge.html.twig' with {status: item.status} %}</td>
                    <td class="text-end">{% include '_partials/item_status_action.html.twig' with {item: item, back: back} %}</td>
                </tr>
            {% endfor %}
        {% endfor %}
        </tbody>
    </table>
</div>
