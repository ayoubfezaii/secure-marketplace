{# Pager for admin lists. params = current (already validated) filters. #}
{% if pager.pages > 1 %}
    <nav class="mt-3" aria-label="Pagination">
        <ul class="pagination pagination-sm justify-content-center flex-wrap">
            <li class="page-item {{ pager.page <= 1 ? 'disabled' }}"><a class="page-link" href="{{ path(route, params|merge({page: pager.page - 1})) }}">Previous</a></li>
            {% for p in max(1, pager.page - 3)..min(pager.pages, pager.page + 3) %}
                <li class="page-item {{ p == pager.page ? 'active' }}"><a class="page-link" href="{{ path(route, params|merge({page: p})) }}">{{ p }}</a></li>
            {% endfor %}
            <li class="page-item {{ pager.page >= pager.pages ? 'disabled' }}"><a class="page-link" href="{{ path(route, params|merge({page: pager.page + 1})) }}">Next</a></li>
        </ul>
    </nav>
{% endif %}
