{# Seller action on one order item: advance to the next status. POST + per-item CSRF token (rule 3). #}
{% if item.nextStatus %}
    <form method="post" action="{{ path('seller_order_item_status', {uuid: item.uuid}) }}" class="d-inline">
        <input type="hidden" name="_token" value="{{ csrf_token('item-status-' ~ item.uuid) }}">
        <input type="hidden" name="status" value="{{ item.nextStatus }}">
        <input type="hidden" name="back" value="{{ back|default('order') }}">
        <button class="btn btn-sm btn-outline-primary">Mark {{ item.nextStatus }}</button>
    </form>
{% endif %}
