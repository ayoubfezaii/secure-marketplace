{# Catalogue card. All values are auto-escaped (rule 2). #}
<div class="card h-100 shadow-sm product-card">
    <a href="{{ path('product_show', {uuid: product.uuid}) }}">
        {% include '_partials/product_image.html.twig' with {product: product, class: 'product-card-img card-img-top'} %}
    </a>
    <div class="card-body d-flex flex-column">
        <span class="small text-muted">{{ product.categoryLabel }}</span>
        <h3 class="h6 card-title mt-1">
            <a href="{{ path('product_show', {uuid: product.uuid}) }}" class="stretched-link text-decoration-none text-body">{{ product.name }}</a>
        </h3>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            <span class="fw-semibold">{{ product.price|format_currency('EUR') }}</span>
            {% if product.stock == 0 %}<span class="badge text-bg-secondary">Out of stock</span>{% endif %}
        </div>
    </div>
</div>
