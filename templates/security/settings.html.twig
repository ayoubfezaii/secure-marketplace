{% extends 'base.html.twig' %}

{% block title %}Security settings · {{ parent() }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="h3 mb-4">Security settings</h1>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5 d-flex align-items-center gap-2">
                        Two-factor authentication (TOTP)
                        {% if totpEnabled %}
                            <span class="badge text-bg-success">Enabled</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Disabled</span>
                        {% endif %}
                    </h2>

                    {% if totpEnabled %}
                        <p>Every login asks for a 6-digit code from your authenticator app.</p>
                        <hr>
                        <h3 class="h6">Disable two-factor authentication</h3>
                        <p class="text-muted small">For your protection, enter your password and a current code.</p>
                        <form method="post" action="{{ path('app_2fa_disable') }}" class="row g-2 align-items-end">
                            <input type="hidden" name="_token" value="{{ csrf_token('totp_disable') }}">
                            <div class="col-md-5">
                                <label class="form-label" for="current_password">Current password</label>
                                <input type="password" id="current_password" name="current_password" class="form-control" autocomplete="current-password" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="disable_code">Code</label>
                                <input type="text" id="disable_code" name="code" class="form-control" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required>
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-outline-danger w-100">Disable</button>
                            </div>
                        </form>
                    {% elseif qrCode %}
                        <ol class="mb-3">
                            <li>Open an authenticator app (Google Authenticator, Microsoft Authenticator, Aegis, 1Password...).</li>
                            <li>Scan this QR code, or type the key manually.</li>
                            <li>Enter the 6-digit code it shows to confirm.</li>
                        </ol>
                        <div class="d-flex flex-wrap gap-4 align-items-center mb-3">
                            <img src="{{ qrCode }}" alt="QR code for your authenticator app" width="220" height="220" class="border rounded">
                            <div>
                                <div class="small text-muted">Manual entry key</div>
                                <code class="fs-6 user-select-all">{{ pendingSecret }}</code>
                            </div>
                        </div>
                        <form method="post" action="{{ path('app_2fa_confirm') }}" class="row g-2 align-items-end">
                            <input type="hidden" name="_token" value="{{ csrf_token('totp_confirm') }}">
                            <div class="col-md-5">
                                <label class="form-label" for="confirm_code">Code from the app</label>
                                <input type="text" id="confirm_code" name="code" class="form-control" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required autofocus>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary w-100">Confirm and enable</button>
                            </div>
                        </form>
                        <form method="post" action="{{ path('app_2fa_cancel') }}" class="mt-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('totp_cancel') }}">
                            <button type="submit" class="btn btn-link btn-sm px-0">Cancel</button>
                        </form>
                    {% else %}
                        <p>Protect your account with a second factor: even with your password, nobody can log in without the code from your phone.</p>
                        <form method="post" action="{{ path('app_2fa_start') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('totp_start') }}">
                            <button type="submit" class="btn btn-primary">Set up two-factor authentication</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
