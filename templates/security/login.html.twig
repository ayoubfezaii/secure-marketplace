{% extends 'base.html.twig' %}

{% block title %}Log in · {{ parent() }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-3">Log in</h1>

                    {% if error %}
                        {# The message is generic ("Invalid credentials."), so it doesn't reveal whether the email exists. #}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    <form method="post" action="{{ path('app_login') }}">
                        <div class="mb-3">
                            <label for="username" class="form-label">Email</label>
                            <input type="email" value="{{ last_username }}" name="_username" id="username"
                                   class="form-control" autocomplete="email" maxlength="180" required autofocus>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" name="_password" id="password" class="form-control"
                                   autocomplete="current-password" required>
                        </div>

                        {# SECURITY (rule 3): login CSRF token, checked by form_login (enable_csrf: true). #}
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button class="btn btn-primary w-100" type="submit">Log in</button>
                    </form>

                    <p class="mt-3 mb-0 text-center small">
                        No account yet? <a href="{{ path('app_register') }}">Register</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
