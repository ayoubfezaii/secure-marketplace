{% extends 'layouts/auth.html.twig' %}
{% import '_ui/forms.html.twig' as f %}

{% block title %}Log in · Maison Secure{% endblock %}

{% block body %}
    <p class="eyebrow mb-2">Welcome back</p>
    <h1 class="mb-2">Log in to your account</h1>
    <p class="text-muted mb-4">Track orders, manage your shop or your wishlist.</p>

    {% if error %}
        {# SECURITY: the message is generic ("Invalid credentials.") for an unknown email AND a wrong password, so it
           doesn't reveal whether an account exists. #}
        <div class="alert alert-danger d-flex gap-2" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>{{ error.messageKey|trans(error.messageData, 'security') }}</span></div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}" novalidate>
        <div class="mb-3">
            <label for="username" class="form-label">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control"
                   autocomplete="email" maxlength="180" required autofocus placeholder="you@example.com">
        </div>
        {{ f.raw_password('password', '_password', 'Password') }}
        <div class="d-flex justify-content-end mb-3 small">
            <a href="{{ path('app_forgot_password_request') }}">Forgot your password?</a>
        </div>
        {# SECURITY (rule 3): login CSRF token, checked by form_login (enable_csrf: true). #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        {# SECURITY (rule 12): passed through but validated server side (LoginSuccessHandler + SafeRedirect);
           auto-escaped here, so it can't break out of the attribute (rule 2). #}
        {% if app.request.query.get('_target_path') %}
            <input type="hidden" name="_target_path" value="{{ app.request.query.get('_target_path') }}">
        {% endif %}
        <button class="btn btn-primary btn-lg w-100" type="submit">Log in</button>
    </form>

    <p class="mt-4 mb-0 text-center">New to Maison Secure? <a class="fw-semibold" href="{{ path('app_register') }}">Create an account</a></p>
    <p class="small text-muted text-center mt-2 mb-0"><i class="bi bi-shield-lock" aria-hidden="true"></i> After 5 wrong passwords the account is locked for 15 minutes.</p>
{% endblock %}
