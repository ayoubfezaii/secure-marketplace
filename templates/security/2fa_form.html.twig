{# FILE: templates/security/2fa_form.html.twig #}
{# WHAT: second step of the login for users with 2FA: the form asking for the 6-digit code. #}
{# USED BY: scheb/2fa-bundle, route /2fa (users whose password was accepted and who enabled 2FA). #}
{% extends 'layouts/auth.html.twig' %}

{% block title %}Two-factor authentication · Maison Secure{% endblock %}
{% block quote %}“Two keys are better than one.”{% endblock %}

{% block body %}
    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-sand mb-3 icon-badge"><i class="bi bi-phone-vibrate fs-4" aria-hidden="true"></i></span>
    <h1 class="mb-2">Two-step verification</h1>
    <p class="text-muted mb-4">Open your authenticator app and enter the 6-digit code for Maison Secure.</p>

    {# Error message given by the 2FA bundle (wrong code, too many tries). #}
    {% if authenticationError %}
        <div class="alert alert-danger d-flex gap-2" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</span></div>
    {% endif %}

    {# SECURITY (rules 5, 6): codes are rate limited per account (5 / 5 min) and a code can't be reused. #}
    {# Code form: it posts to the check route handled by scheb/2fa-bundle (not by one of our controllers). #}
    <form action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" method="post">
        <div class="mb-3">
            <label for="_auth_code" class="form-label">Authentication code</label>
            <input id="_auth_code" type="text" name="{{ authCodeParameterName }}" class="form-control form-control-lg otp-input"
                   autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus placeholder="••••••">
        </div>
        {# SECURITY (rule 3): CSRF token on the code form. #}
        {% if isCsrfProtectionEnabled %}
            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
        {% endif %}
        <button type="submit" class="btn btn-primary btn-lg w-100">Verify and continue</button>
    </form>
    {# Cancel = log out. POST + CSRF, never a GET link (rule 3). #}
    <form method="post" action="{{ path('app_logout') }}" class="mt-3 text-center">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button type="submit" class="btn btn-link btn-sm">Cancel and log out</button>
    </form>
{% endblock %}
