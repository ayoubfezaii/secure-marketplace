{% extends 'base.html.twig' %}

{% block title %}Two-factor authentication · {{ parent() }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-3">Two-factor authentication</h1>
                    <p class="text-muted small">Enter the 6-digit code shown in your authenticator app.</p>

                    {% if authenticationError %}
                        <div class="alert alert-danger">{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</div>
                    {% endif %}

                    <form action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" method="post">
                        <div class="mb-3">
                            <label for="_auth_code" class="form-label">Authentication code</label>
                            <input id="_auth_code" type="text" name="{{ authCodeParameterName }}" class="form-control form-control-lg text-center"
                                   autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus>
                        </div>
                        {# SECURITY (rule 3): CSRF token on the code form. #}
                        {% if isCsrfProtectionEnabled %}
                            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
                        {% endif %}
                        <button type="submit" class="btn btn-primary w-100">Verify</button>
                    </form>

                    {# Cancel = log out. POST + CSRF, never a GET link (rule 3). #}
                    <form method="post" action="{{ path('app_logout') }}" class="mt-3 text-center">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="btn btn-link btn-sm">Cancel and log out</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
