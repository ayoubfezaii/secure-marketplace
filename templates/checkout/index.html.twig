{% extends 'base.html.twig' %}

{% block title %}Checkout · {{ parent() }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">Checkout</h1>
    <div class="row g-4">
        <div class="col-lg-5 order-lg-2">
            <div class="card shadow-sm">
                <div class="card-header">Order summary</div>
                <ul class="list-group list-group-flush">
                    {% for line in lines %}
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ line.product.name }} <span class="text-muted">× {{ line.quantity }}</span></span>
                            <span>{{ line.lineTotal|format_currency('EUR') }}</span>
                        </li>
                    {% endfor %}
                    <li class="list-group-item d-flex justify-content-between fw-semibold">
                        <span>Total</span><span>{{ total|format_currency('EUR') }}</span>
                    </li>
                </ul>
                {# SECURITY (rule 10): this summary is display only. Nothing here is submitted; the server re-reads
                   prices and stock from the database when the order is placed. #}
                <div class="card-footer small text-muted">Prices are checked again when you confirm.</div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5">Payment (simulated)</h2>
                    <p class="small text-muted">No real payment is made. Only the cardholder name and the last 4 digits are stored; the full number and CVV are never saved.</p>
                    {{ form_start(form, {attr: {autocomplete: 'on'}}) }}
                        {{ form_errors(form) }}
                        {{ form_row(form.cardHolder) }}
                        {{ form_row(form.cardNumber) }}
                        <div class="row">
                            <div class="col-6">{{ form_row(form.expiry) }}</div>
                            <div class="col-6">{{ form_row(form.cvv) }}</div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Pay {{ total|format_currency('EUR') }}</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
