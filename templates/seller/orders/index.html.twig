{% extends 'layouts/dashboard.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}
{% import '_ui/table.html.twig' as t %}

{% set page_title = 'Orders' %}
{% set page_subtitle = 'Orders containing your products. You only see your own items and the shipping address.' %}
{% set crumbs = [['Dashboard', path('seller_dashboard')], ['Orders', null]] %}

{% block content %}
    <section class="panel">
        <div class="toolbar">{{ t.filter_chips('status', status, statuses|filter((l, k) => k in ['paid', 'shipped', 'delivered', 'cancelled', 'refunded']), 'seller_orders') }}</div>
        {% if pager.total == 0 %}
            <div class="panel-body">{{ ui.empty_state(status ? 'Nothing here' : 'No orders yet', status ? 'No order has items with this status.' : 'Orders for your products will appear here.', status ? 'Show all' : null, status ? path('seller_orders') : null, 'receipt') }}</div>
        {% else %}
            {% include 'order/_seller_table.html.twig' with {orders: pager.items, back: 'orders'} %}
            {{ t.pager(pager, 'seller_orders', params) }}
        {% endif %}
    </section>
{% endblock %}
