{# FILE: templates/seller/orders/show.html.twig #}
{# WHAT: one order seen by a seller: only the seller's own lines, the shipping address and the cash-on-delivery actions. #}
{# USED BY: Seller\OrderController::show, route /seller/orders/{uuid} (a seller who has items in this order, checked by OrderVoter). #}
{% extends 'layouts/dashboard.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{# Variables read by the dashboard layout: title, subtitle and breadcrumbs. #}
{% set page_title = 'Order ' ~ order.number %}
{% set page_subtitle = 'Placed on ' ~ order.createdAt|date('d M Y \\a\\t H:i') %}
{% set crumbs = [['Dashboard', path('seller_dashboard')], ['Orders', path('seller_orders')], [order.number, null]] %}

{% block content %}
    <div class="row g-4">
        <div class="col-lg-8">
            <section class="panel">
                <div class="panel-head"><h2>Your items in this order</h2><span class="small text-muted">{{ items|length }} line{{ items|length > 1 ? 's' }}</span></div>
                <div class="table-responsive">
                    <table class="table table-cards align-middle">
                        <thead><tr><th scope="col">Product</th><th scope="col" class="text-end">Unit price</th><th scope="col" class="text-end">Qty</th><th scope="col" class="text-end">Total</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
                        <tbody>
                            {# Loop: the lines of this order that belong to the logged-in seller (prepared by the controller). #}
                            {% for item in items %}
                                <tr>
                                    <td class="cell-main">
                                        <div class="cell-product">
                                            <span class="thumb">{{ ui.product_image(item.product ? item.product.mainImageFilename : null, item.productName) }}</span>
                                            <span class="name">{{ item.productName }}</span>
                                        </div>
                                    </td>
                                    <td data-label="Unit price" class="text-end">{{ item.unitPrice|price }}</td>
                                    <td data-label="Qty" class="text-end">{{ item.quantity }}</td>
                                    <td data-label="Total" class="text-end fw-semibold">{{ item.lineTotal|price }}</td>
                                    <td data-label="Status">{{ ui.status_badge(item.status) }}</td>
                                    <td class="text-end text-nowrap">{% include '_partials/item_status_action.html.twig' with {item: item, back: 'order'} %}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="panel-body border-top d-flex justify-content-between">
                    <span class="text-muted">Your share of this order</span><strong>{{ subtotal|price }}</strong>
                </div>
            </section>
        </div>
        <div class="col-lg-4 d-grid gap-4 align-content-start">
            {# The cash-on-delivery block is shown only for cash orders. #}
            {% if order.cashOnDelivery %}
                {#
                    Cash on delivery. SECURITY (privilege matrix): the seller sees the method and the amount to collect,
                    never any card data. Both actions are POST forms with a per-order CSRF token (rule 3); the server
                    re-checks OrderVoter::CASH_COLLECT / CASH_REFUSE (seller of every item, right state) and changes
                    the order inside a locked transaction (OrderManager). Nothing in the form carries an amount.
                #}
                <section class="panel">
                    <div class="panel-head"><h2><i class="bi bi-cash-coin me-1" aria-hidden="true"></i> Cash on delivery</h2>{{ ui.payment_status_badge(order) }}</div>
                    <div class="panel-body">
                        {# Three cases: cash already collected, order cancelled / refused, or still waiting. #}
                        {% if order.paymentStatus.value == 'collected' %}
                            <p class="mb-0">You collected <strong>{{ order.total|price }}</strong> in cash. This order counts in your revenue.</p>
                        {% elseif order.status == 'cancelled' %}
                            <p class="text-muted mb-0">This order was cancelled or refused. Nothing was collected and the items are back in stock.</p>
                        {% else %}
                            <p class="mb-3">Amount to collect at delivery: <strong>{{ order.total|price }}</strong></p>
                            {# Permission check: each button appears only when OrderVoter allows the action. The server checks again on click. #}
                            {% if is_granted('ORDER_CASH_COLLECT', order) or is_granted('ORDER_CASH_REFUSE', order) %}
                                <div class="d-grid gap-2">
                                    {% if is_granted('ORDER_CASH_COLLECT', order) %}
                                        {{ ui.confirm_delete_form(path('seller_order_cash_collected', {uuid: order.uuid}), 'cash-collected-' ~ order.uuid, 'Cash collected', 'Confirm that the buyer paid ' ~ order.total|price ~ ' in cash. This cannot be undone.', 'btn btn-primary w-100', 'cash-coin', {}, 'Yes, cash collected', 'Confirm cash collected?', 'dark') }}
                                    {% endif %}
                                    {% if is_granted('ORDER_CASH_REFUSE', order) %}
                                        {{ ui.confirm_delete_form(path('seller_order_refused', {uuid: order.uuid}), 'cash-refused-' ~ order.uuid, 'Refused at delivery', 'The buyer refused the parcel: the order is cancelled and the items go back in stock. This cannot be undone.', 'btn btn-outline-danger w-100', 'x-circle', {}, 'Yes, refused', 'Mark as refused at delivery?') }}
                                    {% endif %}
                                </div>
                            {% else %}
                                <p class="small text-muted mb-0">Ship and deliver the items first. You can then confirm the cash, or mark the parcel as refused once it has shipped.</p>
                            {% endif %}
                        {% endif %}
                    </div>
                </section>
            {% endif %}
            <section class="panel">
                <div class="panel-head"><h2><i class="bi bi-geo-alt me-1" aria-hidden="true"></i> Ship to</h2></div>
                <div class="panel-body">
                    {# SECURITY (privilege matrix): shipping name + address only. The buyer's email, phone and payment
                       details are never shown to sellers. #}
                    {% if order.shippingLines is not empty %}
                        {# Loop: the lines of the shipping address copied into the order. #}
                        <address class="mb-0">{% for l in order.shippingLines %}{{ l }}<br>{% endfor %}</address>
                    {% else %}
                        <p class="text-muted small mb-0">No address recorded for this older order.</p>
                    {% endif %}
                </div>
            </section>
            <section class="surface p-3 small">
                <p class="fw-semibold mb-2"><i class="bi bi-truck" aria-hidden="true"></i> Fulfilment steps</p>
                {% if order.cashOnDelivery %}
                    <p class="text-muted mb-0">Placed → Shipped → Delivered, then confirm <strong>Cash collected</strong>. Each step can only move forward, one at a time. If the buyer refuses the parcel, mark it <strong>Refused at delivery</strong>: the order is cancelled and the stock restored.</p>
                {% else %}
                    <p class="text-muted mb-0">Paid → Shipped → Delivered. Each step can only move forward, one at a time. Cancelled or refunded items can't be changed.</p>
                {% endif %}
            </section>
        </div>
    </div>
{% endblock %}
