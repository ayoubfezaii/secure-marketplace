{% extends 'layouts/dashboard.html.twig' %}

{% set page_title = 'My shop' %}
{% set page_subtitle = 'Your public shop page.' %}
{% set crumbs = [['Dashboard', path('seller_dashboard')], ['My shop', null]] %}

{% block page_actions %}
    <a class="btn btn-light" href="{{ path('shop_show', {slug: shop.slug}) }}"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open public page</a>
{% endblock %}

{% block content %}
    <div class="row g-4">
        <div class="col-xl-8">
            <section class="panel">
                <div class="panel-body">
                    {# SECURITY (rules 3, 7, 9): CSRF token; explicit fields; the logo goes through ImageStorage. #}
                    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                        {{ form_errors(form) }}
                        {{ form_row(form.name) }}
                        {{ form_row(form.slug) }}
                        {{ form_row(form.description) }}
                        {{ form_row(form.logoFile) }}
                        {% if shop.logoFilename %}{{ form_row(form.removeLogo) }}{% else %}{% do form.removeLogo.setRendered %}{% endif %}
                        <button class="btn btn-primary" type="submit">Save my shop</button>
                    {{ form_end(form) }}
                </div>
            </section>
        </div>
        <div class="col-xl-4">
            <p class="eyebrow mb-2">Preview</p>
            <div class="shop-banner p-4">
                <span class="glow" aria-hidden="true"></span>
                <div class="d-flex align-items-center gap-3 position-relative">
                    <div class="shop-logo">{% if shop.logoFilename %}<img src="{{ path('media_product', {filename: shop.logoFilename}) }}" alt="{{ shop.name }} logo">{% else %}<span aria-hidden="true">{{ shop.initials }}</span>{% endif %}</div>
                    <div class="min-w-0"><p class="h5 text-white mb-1 text-truncate">{{ shop.name }}</p><p class="small text-white-50 mb-0 text-break">/shop/{{ shop.slug }}</p></div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
