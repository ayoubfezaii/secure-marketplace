{% extends 'layouts/dashboard.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{% set page_title = 'Hello, ' ~ (shop ? shop.name : app.user.publicName) %}
{% set page_subtitle = 'Your shop at a glance.' %}
{% set crumbs = [['Dashboard', null]] %}

{% block page_actions %}
    {% if shop %}<a class="btn btn-light" href="{{ path('shop_show', {slug: shop.slug}) }}"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> View my shop</a>{% endif %}
    <a class="btn btn-primary" href="{{ path('seller_product_new') }}"><i class="bi bi-plus-lg" aria-hidden="true"></i> New product</a>
{% endblock %}

{% block content %}
    <div class="row row-cols-2 row-cols-lg-3 row-cols-xxl-5 g-3 mb-4">
        <div class="col">{{ ui.stat_card('Revenue this month', overview.revenueMonth|format_currency('EUR'), 'currency-euro', 'accent', overview.revenueDelta) }}</div>
        <div class="col">{{ ui.stat_card('Units sold this month', overview.unitsMonth, 'bag-check', 'ink') }}</div>
        <div class="col"><a class="text-decoration-none" href="{{ path('seller_orders', {status: 'to_ship'}) }}">{{ ui.stat_card('Pending shipments', overview.pendingShipments, 'truck', overview.pendingShipments > 0 ? 'danger' : 'success', null, overview.pendingShipments > 0 ? 'To ship now' : 'All shipped') }}</a></div>
        <div class="col">{{ ui.stat_card('Active products', overview.activeProducts, 'box-seam', '') }}</div>
        <div class="col">{{ ui.stat_card('Average rating', overview.avgRating is not null ? overview.avgRating ~ ' / 5' : '—', 'star', 'success', null, overview.reviewCount ~ ' review' ~ (overview.reviewCount != 1 ? 's')) }}</div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <section class="panel h-100">
                <div class="panel-head"><h2>Sales, last 30 days</h2><a class="small" href="{{ path('seller_analytics') }}">Analytics <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
                <div class="panel-body">
                    {# SECURITY (rules 2, 13): data handed to JS through an escaped data-* attribute (JSON), no inline <script>. #}
                    <div class="chart-box" {{ stimulus_controller('chart', {config: {type: 'line', title: 'Revenue and units sold, last 30 days', labels: chart.labels, datasets: [{label: 'Revenue (€)', data: chart.revenue}, {label: 'Units', data: chart.units, axis: 'y1'}]}}) }}>
                        <p class="text-muted small">Loading chart…</p>
                    </div>
                </div>
            </section>
        </div>
        <div class="col-xl-4">
            <section class="panel h-100">
                <div class="panel-head"><h2>Top 5 products</h2><span class="small text-muted">30 days</span></div>
                <div class="panel-body">
                    {% for row in topProducts %}
                        <div class="d-flex align-items-center gap-3 {{ not loop.last ? 'mb-3' }}">
                            <span class="fw-bold text-muted">{{ loop.index }}</span>
                            <span class="thumb">{{ ui.product_image(row.product.mainImageFilename, row.product.name) }}</span>
                            <div class="min-w-0 flex-grow-1"><p class="small fw-semibold text-truncate mb-0">{{ row.product.name }}</p><span class="small text-muted">{{ row.units }} sold</span></div>
                            <span class="small fw-semibold">{{ row.revenue|format_currency('EUR') }}</span>
                        </div>
                    {% else %}
                        <p class="small text-muted mb-0">No sales in the last 30 days.</p>
                    {% endfor %}
                </div>
            </section>
        </div>

        <div class="col-xl-8">
            <section class="panel h-100">
                <div class="panel-head"><h2>Orders to ship</h2><a class="small" href="{{ path('seller_orders', {status: 'to_ship'}) }}">All <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
                {% if toShip is empty %}
                    <div class="panel-body text-muted small"><i class="bi bi-check2-circle" aria-hidden="true"></i> Nothing waiting. Well done!</div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-cards align-middle">
                            <thead><tr><th scope="col">Order</th><th scope="col">Product</th><th scope="col">Ship to</th><th scope="col" class="text-end">Qty</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
                            <tbody>
                                {% for item in toShip %}
                                    <tr>
                                        <td class="cell-main"><a class="font-monospace fw-semibold" href="{{ path('seller_order_show', {uuid: item.order.uuid}) }}">{{ item.order.number }}</a><div class="small text-muted">{{ item.order.createdAt|date('d M') }}</div></td>
                                        <td data-label="Product" class="text-truncate">{{ item.productName }}</td>
                                        <td data-label="Ship to">{{ item.order.shippingName ?? '—' }}</td>
                                        <td data-label="Qty" class="text-end">{{ item.quantity }}</td>
                                        <td class="text-end text-nowrap">{% include '_partials/item_status_action.html.twig' with {item: item, back: 'dashboard'} %}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </div>
        <div class="col-xl-4 d-grid gap-4 align-content-start">
            <section class="panel">
                <div class="panel-head"><h2><i class="bi bi-exclamation-circle text-danger me-1" aria-hidden="true"></i> Low stock</h2><span class="small text-muted">&lt; 5 units</span></div>
                <div class="panel-body">
                    {% for p in lowStock %}
                        <div class="d-flex justify-content-between align-items-center {{ not loop.last ? 'mb-2' }}">
                            <a class="small text-truncate me-2" href="{{ path('seller_product_edit', {uuid: p.uuid}) }}">{{ p.name }}</a>
                            <span class="badge status-badge {{ p.stock == 0 ? 'status-refunded' : 'status-shipped' }}">{{ p.stock }} left</span>
                        </div>
                    {% else %}
                        <p class="small text-muted mb-0">All products are well stocked.</p>
                    {% endfor %}
                </div>
            </section>
            <section class="panel">
                <div class="panel-head"><h2>Latest reviews</h2><a class="small" href="{{ path('seller_reviews') }}">All</a></div>
                <div class="panel-body">
                    {% for review in latestReviews %}
                        <div class="{{ not loop.last ? 'mb-3 pb-3 border-bottom' }}">
                            <div class="d-flex justify-content-between">{{ ui.rating_stars(review.rating) }}<span class="small text-muted">{{ review.createdAt|date('d M') }}</span></div>
                            <p class="small mb-1 mt-1 text-truncate-2">{{ review.comment }}</p>
                            <span class="small text-muted">{{ review.author.publicName }} on {{ review.product.name }}</span>
                        </div>
                    {% else %}
                        <p class="small text-muted mb-0">No reviews yet.</p>
                    {% endfor %}
                </div>
            </section>
        </div>
    </div>
{% endblock %}
