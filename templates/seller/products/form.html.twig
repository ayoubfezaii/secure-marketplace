{# FILE: templates/seller/products/form.html.twig #}
{# WHAT: the form to create or edit a product (details, images) with a live preview card. #}
{# USED BY: Seller\ProductController::new and ::edit, routes /seller/products/new and /{uuid}/edit (sellers only, own products). #}
{% extends 'layouts/dashboard.html.twig' %}
{% import '_ui/macros.html.twig' as ui %}

{# Variables read by the dashboard layout. "product" is null when creating. #}
{% set page_title = product ? 'Edit product' : 'New product' %}
{% set page_subtitle = product ? product.name : 'Add a new piece to your shop.' %}
{% set crumbs = [['Dashboard', path('seller_dashboard')], ['Products', path('seller_products')], [page_title, null]] %}

{% block page_actions %}
    {% if product %}<a class="btn btn-light" href="{{ path('product_show', {uuid: product.uuid}) }}"><i class="bi bi-eye" aria-hidden="true"></i> View page</a>{% endif %}
{% endblock %}

{% block content %}
    {#
        SECURITY: form_start adds enctype="multipart/form-data" and the CSRF token (rule 3). Explicit fields only
        (rule 9). Uploaded files are validated by ImageStorage, URL imports by SafeImageFetcher (rules 7, 8).
    #}
    <div class="row g-4" {{ stimulus_controller('preview') }}>
        <div class="col-xl-8">
            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            <section class="panel mb-4">
                <div class="panel-head"><h2>Details</h2></div>
                <div class="panel-body">
                    {# The fields of ProductFormType. form_row() prints the label, the input and the errors. #}
                    {{ form_row(form.name) }}
                    {{ form_row(form.description) }}
                    <div class="row g-3">
                        <div class="col-md-6">{{ form_row(form.category) }}</div>
                        <div class="col-md-6">{{ form_row(form.stock) }}</div>
                        <div class="col-md-6">{{ form_row(form.price) }}</div>
                        <div class="col-md-6">{{ form_row(form.compareAtPrice) }}</div>
                    </div>
                    <div class="form-check form-switch">{{ form_widget(form.isActive) }}{{ form_label(form.isActive) }}</div>
                </div>
            </section>

            <section class="panel mb-4">
                <div class="panel-head"><h2>Images</h2><span class="small text-muted">{{ product ? product.images|length : 0 }} / 4</span></div>
                <div class="panel-body">
                    {# Existing images (edit only): each one with a "remove" checkbox. #}
                    {% if product and product.images is not empty %}
                        <div class="row g-2 mb-3">
                            {# Loop over the images of the product. #}
                            {% for image in product.images %}
                                <div class="col-6 col-md-3">
                                    <div class="image-tile mb-1"><img src="{{ path('media_product', {filename: image.filename}) }}" alt="Image {{ loop.index }} of {{ product.name }}"></div>
                                    {% if form.removeImages is defined %}
                                        <div class="form-check small">
                                            {{ form_widget(form.removeImages[loop.index0]) }}
                                            <label class="form-check-label" for="{{ form.removeImages[loop.index0].vars.id }}">Remove{{ loop.first ? ' (main)' }}</label>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                        {% if form.removeImages is defined %}{% do form.removeImages.setRendered %}{% endif %}
                    {% endif %}
                    {# Upload field (several files) and "import from URL" field. Both are checked on the server. #}
                    {{ form_row(form.imageFiles) }}
                    {{ form_row(form.imageUrl) }}
                    <p class="small text-muted mb-0"><i class="bi bi-shield-check" aria-hidden="true"></i> Every image is checked (real file type, size, dimensions), re-encoded and renamed before it is stored.</p>
                </div>
            </section>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-lg">{{ product ? 'Save changes' : 'Create product' }}</button>
                <a class="btn btn-light btn-lg" href="{{ path('seller_products') }}">Cancel</a>
            </div>
            {# form_end() closes the form and prints the hidden CSRF token. #}
            {{ form_end(form) }}

            {# Delete block (edit only): a separate POST form with its own CSRF token and a confirmation window. #}
            {% if product %}
                <section class="panel mt-4 border-danger-subtle">
                    <div class="panel-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div><h2 class="h6 mb-1">Delete this product</h2><p class="small text-muted mb-0">Removes the listing and its images. Past orders keep their own copy.</p></div>
                        {{ ui.confirm_delete_form(path('seller_product_delete', {uuid: product.uuid}), 'delete-product-' ~ product.uuid, 'Delete product', '“' ~ product.name ~ '” will be permanently deleted.', 'btn btn-outline-danger', 'trash3', {}, 'Delete', 'Delete this product?') }}
                    </div>
                </section>
            {% endif %}
        </div>

        {# ---------- Live preview (Stimulus "preview": textContent only, never innerHTML, rule 2) ---------- #}
        <div class="col-xl-4">
            <div class="preview-sticky">
                <p class="eyebrow mb-2">Live preview</p>
                <article class="product-card">
                    <div class="media">
                        {# The data-preview-target elements below are filled by the preview controller while the seller types. #}
                        <div class="badges"><span class="badge badge-sale" hidden {{ stimulus_target('preview', 'outSale') }}></span></div>
                        {{ ui.product_image(product ? product.mainImageFilename : null, 'Preview') }}
                    </div>
                    <div class="body">
                        <span class="meta" {{ stimulus_target('preview', 'outCategory') }}>{{ product ? product.categoryLabel }}</span>
                        <span class="title" {{ stimulus_target('preview', 'outName') }}>{{ product ? product.name : 'Product name' }}</span>
                        <div class="mt-auto pt-1"><span class="price" {{ stimulus_target('preview', 'outPrice') }}></span><span class="price-old" {{ stimulus_target('preview', 'outOldPrice') }}></span></div>
                    </div>
                </article>
                <p class="small text-muted mt-2">This is how your product appears in the catalogue.</p>
            </div>
        </div>
    </div>
{% endblock %}
