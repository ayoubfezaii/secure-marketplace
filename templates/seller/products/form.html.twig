{% extends 'dashboard/_layout.html.twig' %}

{% block title %}{{ product ? 'Edit product' : 'New product' }} · {{ parent() }}{% endblock %}

{% block dash_content %}
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <a href="{{ path('seller_products') }}" class="small">&larr; My products</a>
            <h1 class="h3 my-3">{{ product ? 'Edit product' : 'New product' }}</h1>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    {# form_start adds enctype="multipart/form-data" and the CSRF token (rule 3). #}
                    {{ form_start(form) }}
                        {{ form_errors(form) }}
                        <div class="row">
                            <div class="col-md-8">{{ form_row(form.name) }}</div>
                            <div class="col-md-4">{{ form_row(form.category) }}</div>
                        </div>
                        {{ form_row(form.description) }}
                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.price) }}</div>
                            <div class="col-md-6">{{ form_row(form.stock) }}</div>
                        </div>
                        {{ form_row(form.isActive) }}

                        <hr>
                        <h2 class="h6">Image</h2>
                        <div class="row align-items-start">
                            {% if product and product.imageFilename %}
                                <div class="col-md-3 mb-3">
                                    {% include '_partials/product_image.html.twig' with {product: product, class: 'img-fluid rounded border'} %}
                                    <div class="small text-muted mt-1">Current image</div>
                                </div>
                            {% endif %}
                            <div class="col">
                                {{ form_row(form.imageFile) }}
                                {{ form_row(form.imageUrl) }}
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">{{ product ? 'Save changes' : 'Create product' }}</button>
                            <a href="{{ path('seller_products') }}" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
