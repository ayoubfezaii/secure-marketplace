{% extends 'dashboard/_layout.html.twig' %}

{% block title %}My products · {{ parent() }}{% endblock %}

{% block dash_content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">My products</h1>
        <a href="{{ path('seller_product_new') }}" class="btn btn-primary">New product</a>
    </div>

    {% if products is empty %}
        <div class="text-center text-muted py-5 bg-white rounded-3 border">
            <p class="mb-2">You haven't listed any product yet.</p>
            <a href="{{ path('seller_product_new') }}" class="btn btn-outline-primary btn-sm">Create your first product</a>
        </div>
    {% else %}
        {% include 'seller/products/_table.html.twig' with {products: products, back: 'products'} %}
    {% endif %}
{% endblock %}
