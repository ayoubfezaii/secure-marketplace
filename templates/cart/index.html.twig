{% extends 'base.html.twig' %}

{% block title %}My cart · {{ parent() }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">My cart</h1>

    {% if lines is empty %}
        <div class="text-center text-muted py-5 bg-white rounded-3 border">
            <p class="mb-2">Your cart is empty.</p>
            <a href="{{ path('product_index') }}" class="btn btn-outline-primary btn-sm">Browse products</a>
        </div>
    {% else %}
        <div class="table-responsive bg-white rounded-3 border mb-3">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr><th class="col-thumb"></th><th>Product</th><th class="text-end">Unit price</th><th>Quantity</th><th class="text-end">Total</th><th></th></tr>
                </thead>
                <tbody>
                {% for line in lines %}
                    {% set p = line.product %}
                    <tr>
                        <td>{% include '_partials/product_image.html.twig' with {product: p, class: 'thumb-sm rounded'} %}</td>
                        <td>
                            <a href="{{ path('product_show', {uuid: p.uuid}) }}">{{ p.name }}</a>
                            {% if not p.purchasable %}<div class="small text-danger">No longer available</div>
                            {% elseif line.quantity > p.stock %}<div class="small text-danger">Only {{ p.stock }} left</div>{% endif %}
                        </td>
                        <td class="text-end">{{ p.price|format_currency('EUR') }}</td>
                        <td>
                            <form method="post" action="{{ path('cart_update', {uuid: p.uuid}) }}" class="d-flex gap-1">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart-update-' ~ p.uuid) }}">
                                <input type="number" name="quantity" value="{{ line.quantity }}" min="1" max="{{ min(99, max(1, p.stock)) }}" class="form-control form-control-sm qty-input" aria-label="Quantity">
                                <button class="btn btn-sm btn-outline-secondary">Update</button>
                            </form>
                        </td>
                        <td class="text-end">{{ line.lineTotal|format_currency('EUR') }}</td>
                        <td class="text-end">
                            <form method="post" action="{{ path('cart_remove', {uuid: p.uuid}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart-remove-' ~ p.uuid) }}">
                                <button class="btn btn-sm btn-link text-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr><th colspan="4" class="text-end">Total</th><th class="text-end">{{ total|format_currency('EUR') }}</th><th></th></tr>
                </tfoot>
            </table>
        </div>
        <div class="d-flex justify-content-between">
            <a href="{{ path('product_index') }}" class="btn btn-outline-secondary">Continue shopping</a>
            <a href="{{ path('checkout') }}" class="btn btn-primary">Proceed to checkout</a>
        </div>
    {% endif %}
{% endblock %}
