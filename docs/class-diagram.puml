class Review {
  - id : ?int
  - uuid : Uuid
  - product : Product
  - author : User
  - rating : int
  - comment : string
  - createdAt : DateTimeImmutable
  - updatedAt : ?DateTimeImmutable
  - reply : ?ReviewReply
  --
  + markEdited() : void
  + setReply(reply : ?ReviewReply) : void
}

class ReviewReply {
  - id : ?int
  - uuid : Uuid
  - review : Review
  - author : User
  - body : string
  - createdAt : DateTimeImmutable
  --
  + setBody(body : ?string) : static
}

class SellerApplication {
  + {static} STATUS_PENDING : string
  + {static} STATUS_APPROVED : string
  + {static} STATUS_REJECTED : string
  + {static} STATUSES : array
  - id : ?int
  - uuid : Uuid
  - applicant : User
  - shopName : string
  - description : string
  - status : string
  - reason : ?string
  - reviewedBy : ?User
  - reviewedAt : ?DateTimeImmutable
  - createdAt : DateTimeImmutable
  --
  + approve(admin : User) : void
  + reject(admin : User, reason : string) : void
  - decide(admin : User, status : string, reason : ?string) : void
  + isPending() : bool
}

class AuditLog {
  + {static} SECURITY_EVENTS : array
  - id : ?int
  - user : ?User
  - action : string
  - details : array
  - ip : ?string
  - userAgent : ?string
  - createdAt : DateTimeImmutable
}

class ResetPasswordRequest {
  - id : ?int
  - user : User
  # selector : string
  # hashedToken : string
  # requestedAt : DateTimeImmutable
  # expiresAt : DateTimeInterface
  --
  + isExpired() : bool
}

class NewsletterSubscriber {
  - id : ?int
  - email : string
  - createdAt : DateTimeImmutable
}

enum PaymentMethod {
  Card
  CashOnDelivery
  --
  + label() : string
  + icon() : string
}

enum PaymentStatus {
  Paid
  Pending
  Collected
  Refunded
  --
  + label() : string
  + {static} settledValues() : array
}

' --- OneToOne, bidirectional (owning side: Shop.owner, onDelete CASCADE) ---
User "1" -- "0..1" Shop : owner / shop

' --- Compositions: Doctrine cascade / orphanRemoval ---
' OneToMany, cascade persist + remove, orphanRemoval (max 4, enforced in Product::addImage)
Product "1" *-- "0..*" ProductImage : images
' OneToMany, cascade persist
Order "1" *-- "1..*" OrderItem : items
' OneToOne, cascade remove
Review "1" *-- "0..1" ReviewReply : reply

' --- ManyToOne, unidirectional ---
Product "0..*" --> "1" User : seller
Product "0..*" --> "1" Category : category
CartItem "0..*" --> "1" User : user
CartItem "0..*" --> "1" Product : product
WishlistItem "0..*" --> "1" User : user
WishlistItem "0..*" --> "1" Product : product
Address "0..*" --> "1" User : user
Order "0..*" --> "1" User : buyer
OrderItem "0..*" --> "0..1" Product : product
OrderItem "0..*" --> "1" User : seller
Review "0..*" --> "1" Product : product
Review "0..*" --> "1" User : author
ReviewReply "0..*" --> "1" User : author
SellerApplication "0..*" --> "1" User : applicant
SellerApplication "0..*" --> "0..1" User : reviewedBy
AuditLog "0..*" --> "0..1" User : user
ResetPasswordRequest "0..*" --> "1" User : user

' --- Enums used as column types ---
Order ..> PaymentMethod : paymentMethod
Order ..> PaymentStatus : paymentStatus

note right of ResetPasswordRequest
  The protected fields and isExpired()
  come from the bundle's
  ResetPasswordRequestTrait.
end note

note right of OrderItem
  product is nullable (SET NULL):
  productName and unitPrice are
  snapshots taken at checkout.
end note

@enduml
