class OrderItem {
  + {static} TRANSITIONS : array
  - id : ?int
  - uuid : Uuid
  - order : Order
  - product : ?Product
  - seller : User
  - productName : string
  - unitPrice : string
  - quantity : int
  - status : string
  --
  + getLineTotal() : string
  + getNextStatus() : ?string
