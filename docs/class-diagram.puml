@startuml class-diagram
' Class diagram of the Doctrine entities (src/Entity) and the enums used as column types (src/Enum).
' Same content as docs/class-diagram.md (Mermaid version). Render: plantuml docs/class-diagram.puml
'
' Fields: every real property with its PHP type ("?" = nullable).
' Methods: main business methods only (plain getters / setters and backdate() are left out).
' Relations:  -->  unidirectional ManyToOne      --  bidirectional association
'             *--  composition (Doctrine cascade and / or orphanRemoval)
'             ..>  enum used as a column type
' There is no ManyToMany mapping in the project.

title Secure Marketplace - Doctrine entities

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

class User {
  + {static} ROLE_BUYER : string
  + {static} ROLE_SELLER : string
  + {static} ROLE_ADMIN : string
  + {static} MAX_FAILED_ATTEMPTS : int
  + {static} LOCKOUT_DURATION : string
  - id : ?int
  - uuid : Uuid
  - email : string
  - roles : array
  - password : string
  - failedAttempts : int
  - lockedUntil : ?DateTimeImmutable
  - blocked : bool
  - isVerified : bool
  - displayName : ?string
  - phone : ?string
  - ibanEncrypted : ?string
  - ibanLast4 : ?string
  - totpSecret : ?string
  - totpEnabled : bool
  - createdAt : DateTimeImmutable
  - lastLoginAt : ?DateTimeImmutable
  - shop : ?Shop
  --
  + getUserIdentifier() : string
  + setRoles(roles : array) : static
  + isBuyer() : bool
  + isSeller() : bool
  + isAdmin() : bool
  + isLocked() : bool
  + block() : void
  + unblock() : void
  + registerFailedLogin() : void
  + resetFailedLogins() : void
  + recordLogin() : void
  + getPublicName() : string
  + setEncryptedIban(ciphertext : string, last4 : string) : static
  + removeIban() : void
  + getMaskedIban() : ?string
  + isTotpAuthenticationEnabled() : bool
  + getTotpAuthenticationConfiguration() : ?TotpConfigurationInterface
  + enableTotp() : void
  + disableTotp() : void
  + __serialize() : array
  + eraseCredentials() : void
}

class Shop {
  + {static} RESERVED_SLUGS : array
  - id : ?int
  - owner : User
  - name : string
  - slug : string
  - description : ?string
  - logoFilename : ?string
  - createdAt : DateTimeImmutable
  --
  + {static} validateSlug(value : mixed, context : ExecutionContextInterface) : void
  + {static} slugify(name : string) : string
  + getInitials() : string
}

class Category {
  + {static} ICONS : array
  - id : ?int
  - name : string
  - slug : string
  - icon : string
  - position : int
  - tagline : ?string
  --
  + __toString() : string
}

class Product {
  + {static} MAX_IMAGES : int
  + {static} NEW_DAYS : int
  - id : ?int
  - uuid : Uuid
  - seller : User
  - name : string
  - description : string
  - price : string
  - compareAtPrice : ?string
  - stock : int
  - category : Category
  - images : Collection<ProductImage>
  - isActive : bool
  - ratingAverage : string
  - ratingCount : int
  - createdAt : DateTimeImmutable
  - updatedAt : DateTimeImmutable
  --
  + validateCompareAtPrice(context : ExecutionContextInterface) : void
  + touch() : void
  + getShop() : ?Shop
  + isOnSale() : bool
  + getDiscountPercent() : int
  + isNew() : bool
  + isPurchasable() : bool
  + decreaseStock(quantity : int) : void
  + restoreStock(quantity : int) : void
  + canAddImage() : bool
  + addImage(filename : string) : ProductImage
  + removeImage(image : ProductImage) : void
  + getMainImageFilename() : ?string
  + setRatingSummary(average : float, count : int) : void
}

class ProductImage {
  - id : ?int
  - product : Product
  - filename : string
  - position : int
  --
  + setPosition(position : int) : void
}

class CartItem {
  + {static} MAX_QUANTITY : int
  - id : ?int
  - user : User
  - product : Product
  - quantity : int
  - createdAt : DateTimeImmutable
  --
  + setQuantity(quantity : int) : void
  + getLineTotal() : string
}

class WishlistItem {
  - id : ?int
  - user : User
  - product : Product
  - createdAt : DateTimeImmutable
}

class Address {
  + {static} MAX_PER_USER : int
  + {static} COUNTRIES : array
  - id : ?int
  - uuid : Uuid
  - user : User
  - label : string
  - fullName : string
  - line1 : string
  - line2 : ?string
  - postalCode : string
  - city : string
  - country : string
  - phone : ?string
  - isDefault : bool
  - createdAt : DateTimeImmutable
  --
  + {static} countryCodes() : array
  + getCountryName() : string
  + getLines() : array
