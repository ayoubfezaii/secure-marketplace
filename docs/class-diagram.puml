class Order {
  + {static} STATUS_PLACED : string
  + {static} STATUS_PAID : string
  + {static} STATUS_SHIPPED : string
  + {static} STATUS_DELIVERED : string
  + {static} STATUS_CANCELLED : string
  + {static} STATUS_REFUNDED : string
  + {static} STATUSES : array
  + {static} SOLD_STATUSES : array
  + {static} AWAITING_SHIPMENT : array
  + {static} ACTIVE_STATUSES : array
  - id : ?int
  - uuid : Uuid
  - buyer : User
  - total : string
  - status : string
  - paymentMethod : PaymentMethod
  - paymentStatus : PaymentStatus
  - cardHolder : ?string
  - cardLast4 : ?string
  - createdAt : DateTimeImmutable
  - shippingName : ?string
  - shippingLine1 : ?string
  - shippingLine2 : ?string
  - shippingPostalCode : ?string
  - shippingCity : ?string
  - shippingCountry : ?string
  - items : Collection<OrderItem>
  --
  + addItem(item : OrderItem) : void
  + refreshStatus() : void
  + getInitialStatus() : string
  + getNumber() : string
  + setShippingAddress(address : Address) : void
  + getShippingLines() : array
  + getItemsForSeller(seller : User) : array
  + hasSeller(seller : User) : bool
  + isSoldOnlyBy(seller : User) : bool
  + isCashOnDelivery() : bool
  + isCashPending() : bool
  + isCashCollectable() : bool
  + isDeliveryRefusable() : bool
  + isCancellable() : bool
  + isRefundable() : bool
  + markCancelled() : void
  + markCashCollected() : void
  + markRefusedAtDelivery() : void
