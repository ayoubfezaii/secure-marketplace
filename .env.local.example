# .env.local.example — template for your local, git-ignored .env.local
#
#   cp .env.local.example .env.local      (Windows cmd: copy .env.local.example .env.local)
#
# Then replace every placeholder below. NEVER commit .env.local (it is in .gitignore).
# SECURITY (rule 11): this example only holds placeholders; real secrets live in .env.local
# (dev) or in the Symfony secrets vault (prod: php bin/console secrets:set NAME --env=prod).

###> doctrine/doctrine-bundle ###
# Database connection (XAMPP MariaDB). Default XAMPP user is "root" with an EMPTY password,
# so on a fresh XAMPP install the URL looks like mysql://root:@127.0.0.1:3306/...
# Keep the serverVersion matching your MariaDB (XAMPP: phpMyAdmin home page, or "SELECT VERSION();").
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/secure_marketplace?serverVersion=10.4.32-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

# Mail transport. Mailpit catches every e-mail locally (SMTP on port 1025, web UI on http://localhost:8025).
MAILER_DSN=smtp://localhost:1025

# 32-byte libsodium key (64 hex characters) used to encrypt sellers' IBANs (src/Service/FieldEncryptor.php).
# Generate one:  php -r "echo sodium_bin2hex(sodium_crypto_secretbox_keygen()), PHP_EOL;"
# Each teammate can use their own key; IBANs encrypted with another key cannot be decrypted (re-run fixtures).
APP_ENCRYPTION_KEY=change_me_64_hex_characters

# Symfony kernel secret (HMAC key for CSRF tokens, reset tokens, signed URLs, remember-me...).
# Generate one:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=change_me_64_hex_characters
